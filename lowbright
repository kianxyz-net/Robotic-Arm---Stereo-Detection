        private void Load()
        {
            if (!System.IO.File.Exists(CalibFile)) return;
            try
            {
                using var fs = new FileStorage(CalibFile, FileStorage.Modes.Read);
                K1 = fs["K1"]?.ReadMat(); K2 = fs["K2"]?.ReadMat();
                D1 = fs["D1"]?.ReadMat(); D2 = fs["D2"]?.ReadMat();
                R = fs["R"]?.ReadMat(); T = fs["T"]?.ReadMat();
                imageSize = new Size(fs["imageWidth"]?.ReadInt() ?? 0, fs["imageHeight"]?.ReadInt() ?? 0);

                if (K1 != null && K2 != null && R != null && T != null && imageSize.Width > 0)
                {
                    // Recompute rectification with current alpha setting (instead of loading old maps)
                    R1 = new Mat(); R2 = new Mat();
                    P1 = new Mat(); P2 = new Mat();
                    Q = new Mat();
                    
                    // alpha=-1 lets OpenCV choose optimal value
                    Cv2.StereoRectify(K1, D1!, K2, D2!, imageSize, R, T,
                        R1, R2, P1, P2, Q,
                        StereoRectificationFlags.ZeroDisparity, -1, imageSize);
                    
                    map1x = new Mat(); map1y = new Mat();
                    map2x = new Mat(); map2y = new Mat();
                    Cv2.InitUndistortRectifyMap(K1, D1!, R1, P1, imageSize, MatType.CV_32FC1, map1x, map1y);
                    Cv2.InitUndistortRectifyMap(K2, D2!, R2, P2, imageSize, MatType.CV_32FC1, map2x, map2y);
                    
                    InitStereoMatcher();
                    IsCalibrated = true;
                    Console.WriteLine($"Loaded calibration (baseline: {Cv2.Norm(T):F1}mm), recomputed rectification with alpha=-1");
                }
            }
            catch (Exception ex) { Console.WriteLine($"Load failed: {ex.Message}"); IsCalibrated = false; }
        }
        
