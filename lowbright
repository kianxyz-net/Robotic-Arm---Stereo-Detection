        // Get rectified frames for color detection (caller must dispose)
        public (Mat? rect1, Mat? rect2) RectifyFrames(Mat frame1, Mat frame2)
        {
            if (!IsCalibrated || map1x == null || map1y == null || map2x == null || map2y == null)
                return (null, null);
            
            var r1 = new Mat();
            var r2 = new Mat();
            Cv2.Remap(frame1, r1, map1x, map1y, InterpolationFlags.Linear);
            Cv2.Remap(frame2, r2, map2x, map2y, InterpolationFlags.Linear);
            
            return (r1, r2);
        }

        public (float x, float y, float z) GetDepthAtPoint(Mat disparity, int px, int py)
        {
            if (!IsCalibrated || Q == null || disparity.Empty()) return (0, 0, 0);

            short dv = disparity.At<short>(py, px);
            float d = dv / 16f;
            if (d <= 0) return (0, 0, 0);

            double cx = -Q.At<double>(0, 3);
            double cy = -Q.At<double>(1, 3);
            double f = Q.At<double>(2, 3);
            double invTx = Math.Abs(Q.At<double>(3, 2));
            double cxDiff = Q.At<double>(3, 3);

            double W = d * invTx + cxDiff;
            if (Math.Abs(W) < 1e-9) return (0, 0, 0);

            float zVal = (float)(f / W);

            return ((float)((px - cx) / W), (float)((py - cy) / W), zVal);
        }

        private bool _depthDiagPrinted = false;
        private DateTime _lastDispDiag = DateTime.MinValue;
        public bool TryGetDepthInBox(Mat disparity, Rect box, out float x, out float y, out float z)
        {
            x = y = z = 0;

            if (!IsCalibrated || K1 == null || P1 == null || P2 == null || Q == null || T == null || disparity.Empty())
                return false;

            // Use Q matrix for 3D reprojection (consistent with GetDepthAtPoint)
            // Q matrix structure: Q[0,3] = -cx, Q[1,3] = -cy, Q[2,3] = f
            double cx = -Q.At<double>(0, 3);  // Principal point x (rectified)
            double cy = -Q.At<double>(1, 3);  // Principal point y (rectified)
            double f = Q.At<double>(2, 3);    // Focal length
            double fx = f;  // Q uses single focal length (assumes fx=fy after rectification)
            double fy = f;
            double p2_03 = P2.At<double>(0, 3);  // = -(Tx * f) for depth calculation
            
            if (!_depthDiagPrinted)
            {
                double p1_cx = P1.At<double>(0, 2);
                double baseline = Math.Abs(T.At<double>(0, 0));
                Console.WriteLine($"Depth calc using Q matrix: cx={cx:F1}, cy={cy:F1}, f={f:F1}");
                Console.WriteLine($"  (P1.cx was {p1_cx:F1} - may differ from Q!)");
                Console.WriteLine($"  P2[0,3]={p2_03:F1}, baseline={baseline:F1}mm");
                Console.WriteLine($"  Box center pixel: ({box.X + box.Width/2}, {box.Y + box.Height/2})");
                _depthDiagPrinted = true;
            }
            
            // Convert disparity to float
            using var dispFloat = new Mat();
            disparity.ConvertTo(dispFloat, MatType.CV_32F, 1.0 / 16.0);

            // Sample only center 50% of bounding box to avoid edges/background
            int marginX = box.Width / 4;
            int marginY = box.Height / 4;
            Rect innerBox = new Rect(
                box.X + marginX,
                box.Y + marginY,
                box.Width - marginX * 2,
                box.Height - marginY * 2
            );

            int stepX = Math.Max(1, innerBox.Width / 8);
            int stepY = Math.Max(1, innerBox.Height / 8);

            List<(float x, float y, float z)> validPoints = new();
            List<float> disparities = new();

            for (int yy = innerBox.Y; yy < innerBox.Y + innerBox.Height; yy += stepY)
            {
                for (int xx = innerBox.X; xx < innerBox.X + innerBox.Width; xx += stepX)
                {
                    if (xx < 0 || yy < 0 || xx >= dispFloat.Width || yy >= dispFloat.Height)
                        continue;

                    float d = dispFloat.At<float>(yy, xx);
                    
                    // Need positive disparity for valid depth
                    if (d <= 0) continue;
                    
                    disparities.Add(d);
                    
                    // Depth calculation - use empirical calibration if available
                    float pz;
                    if (IsDepthCalibrated)
                    {
                        // Use empirically calibrated formula: Z = Scale / (d + Offset)
                        pz = (float)ApplyDepthCalibration(d);
                    }
                    else
                    {
                        // Fall back to theoretical: Z = -P2[0,3] / disparity
                        pz = (float)(-p2_03 / d);
                    }
                    
                    // Filter valid depth range (50mm to 5000mm)
                    if (pz > 50 && pz < 5000)
                    {
                        // Calculate X and Y from pixel coordinates
                        float px = (float)((xx - cx) * pz / fx);
                        float py = (float)((yy - cy) * pz / fy);
                        validPoints.Add((px, py, pz));
                    }
                }
            }

            if (validPoints.Count < 1)
                return false;

            // Sort by Z and take median
            validPoints.Sort((a, b) => a.z.CompareTo(b.z));
            var median = validPoints[validPoints.Count / 2];
            
            // Print disparity diagnostics every 3 seconds (but not during calibration)
            if (!IsCapturing && !QuietMode && disparities.Count > 0 && (DateTime.Now - _lastDispDiag).TotalSeconds >= 3)
            {
                disparities.Sort();
                float medDisp = disparities[disparities.Count / 2];
                string mode = IsDepthCalibrated ? "empirical" : "theoretical";
                
                // Show pixel coords and calculation for debugging
                int centerPixelX = box.X + box.Width / 2;
                int centerPixelY = box.Y + box.Height / 2;
                double expectedX = (centerPixelX - cx) * median.z / fx;
                Console.WriteLine($"Disparity: median={medDisp:F1}px, samples={disparities.Count}/{(innerBox.Width/stepX)*(innerBox.Height/stepY)}, Z={median.z:F0}mm ({mode})");
                Console.WriteLine($"  Pixel center: ({centerPixelX},{centerPixelY}), cx={cx:F1} → X={(centerPixelX-cx):F0}px * {median.z:F0}/{fx:F0} = {expectedX:F0}mm");
                Console.WriteLine($"  Result: X={median.x:F0}, Y={median.y:F0}mm");
                _lastDispDiag = DateTime.Now;
            }
            
            x = median.x;
            y = median.y;
            z = median.z;

            return true;
        }

        // Get 3D coordinates for a single point (for hand-eye calibration)
        public (bool success, float x, float y, float z) GetPointDepth(Mat frame1, Mat frame2, float pixelX, float pixelY)
        {
            if (!IsCalibrated || K1 == null || P1 == null || P2 == null || Q == null)
                return (false, 0, 0, 0);
            
            using var disp = ComputeDisparity(frame1, frame2);
            if (disp == null || disp.Empty())
                return (false, 0, 0, 0);
            
            using var dispFloat = new Mat();
            disp.ConvertTo(dispFloat, MatType.CV_32F, 1.0 / 16.0);
            
            // Q matrix for reprojection
            double cx = -Q.At<double>(0, 3);
            double cy = -Q.At<double>(1, 3);
            double f = Q.At<double>(2, 3);
            double p2_03 = P2.At<double>(0, 3);
            
            // Sample a small area around the point and take median
            int radius = 5;
            List<float> disparities = new();
            
            int px = (int)pixelX;
            int py = (int)pixelY;
            
            for (int dy = -radius; dy <= radius; dy++)
            {
                for (int dx = -radius; dx <= radius; dx++)
                {
                    int xx = px + dx;
                    int yy = py + dy;
                    if (xx >= 0 && yy >= 0 && xx < dispFloat.Width && yy < dispFloat.Height)
                    {
                        float d = dispFloat.At<float>(yy, xx);
                        if (d > 0) disparities.Add(d);
                    }
                }
            }
            
            if (disparities.Count < 5)
                return (false, 0, 0, 0);
            
            disparities.Sort();
            float medDisp = disparities[disparities.Count / 2];
            
            // Calculate Z using theoretical formula (scale will be corrected by Umeyama)
            float z = (float)(-p2_03 / medDisp);
            
            if (z <= 0 || z > 5000)
                return (false, 0, 0, 0);
            
            // Calculate X and Y (negate Y so Y+ is up, not down)
            float x = (float)((pixelX - cx) * z / f);
            float y = (float)-((pixelY - cy) * z / f);  // Negated: Y+ = up
            
            return (true, x, y, z);
        }

        // Triangulate 3D point from pixel coordinates in both cameras
        // This is more accurate than disparity-based depth for matched detections
        public (bool success, float x, float y, float z) TriangulatePoint(float pixel1X, float pixel1Y, float pixel2X, float pixel2Y)
        {
            if (!IsCalibrated || P1 == null || P2 == null)
                return (false, 0, 0, 0);
            
            // Points must be in rectified image coordinates
            // Create 2xN matrices for triangulatePoints (use float, same as P matrices)
            using var pts1 = new Mat(2, 1, MatType.CV_32F);
            using var pts2 = new Mat(2, 1, MatType.CV_32F);
            
            pts1.Set(0, 0, pixel1X);
            pts1.Set(1, 0, pixel1Y);
            pts2.Set(0, 0, pixel2X);
            pts2.Set(1, 0, pixel2Y);
            
            // Convert P matrices to float if needed
            using var P1f = new Mat();
            using var P2f = new Mat();
            P1.ConvertTo(P1f, MatType.CV_32F);
            P2.ConvertTo(P2f, MatType.CV_32F);
            
            using var point4D = new Mat();
            Cv2.TriangulatePoints(P1f, P2f, pts1, pts2, point4D);
            
            // point4D is 4x1 CV_32F
            float w = point4D.At<float>(3, 0);
            if (Math.Abs(w) < 1e-6f)
                return (false, 0, 0, 0);
            
            float x = point4D.At<float>(0, 0) / w;
            float y = point4D.At<float>(1, 0) / w;
            float z = point4D.At<float>(2, 0) / w;
            
            // Validate - Z should be positive (in front of camera)
            if (z <= 0 || z > 10000)
                return (false, 0, 0, 0);
            
            // Negate Y so Y+ is up (consistent with disparity method)
            y = -y;
            
            return (true, x, y, z);
        }
        
        // Compute 3D from pixel coordinates and known disparity value
        // This is simpler and more accurate when disparity is from matched feature points
        public (bool success, float x, float y, float z) ComputeDepthFromDisparity(float pixelX, float pixelY, float disparity)
        {
            if (!IsCalibrated || Q == null || P2 == null)
                return (false, 0, 0, 0);
            
            if (disparity <= 0)
                return (false, 0, 0, 0);
            
            // Extract calibration values from Q and P2
            double cx = -Q.At<double>(0, 3);
            double cy = -Q.At<double>(1, 3);
            double f = Q.At<double>(2, 3);
            double p2_03 = P2.At<double>(0, 3);  // -baseline * focal (sign varies by camera order)
            
            // Z = |P2[0,3]| / disparity (use absolute value for camera order independence)
            float z = (float)(Math.Abs(p2_03) / disparity);
            
            if (z <= 0 || z > 5000)
                return (false, 0, 0, 0);
            
            // X and Y from pixel coordinates
            float x = (float)((pixelX - cx) * z / f);
            float y = (float)-((pixelY - cy) * z / f);  // Negated: Y+ = up
            
            return (true, x, y, z);
        }
        
        // Rectify a raw image point to rectified coordinates
        public (float rx, float ry) RectifyPoint(float rawX, float rawY, bool isLeftCamera)
        {
            if (!IsCalibrated)
                return (rawX, rawY);
            
            var mapX = isLeftCamera ? map1x : map2x;
            var mapY = isLeftCamera ? map1y : map2y;
            
            if (mapX == null || mapY == null)
                return (rawX, rawY);
            
            int px = Math.Clamp((int)rawX, 0, mapX.Width - 1);
            int py = Math.Clamp((int)rawY, 0, mapX.Height - 1);
            
            // The rectify maps give the SOURCE pixel for each DESTINATION pixel
            // We need the inverse - where does this raw pixel end up in rectified image?
            // For simplicity, we can apply undistortion + rectification directly to the point
            
            var K = isLeftCamera ? K1 : K2;
            var D = isLeftCamera ? D1 : D2;
            var R = isLeftCamera ? R1 : R2;
            var P = isLeftCamera ? P1 : P2;
            
            if (K == null || D == null || R == null || P == null)
                return (rawX, rawY);
            
            using var srcPts = new Mat(1, 1, MatType.CV_64FC2);
            srcPts.Set(0, 0, new Vec2d(rawX, rawY));
            
            using var dstPts = new Mat();
            Cv2.UndistortPoints(srcPts, dstPts, K, D, R, P);
            
            var rectified = dstPts.At<Vec2d>(0, 0);
            return ((float)rectified.Item0, (float)rectified.Item1);
        }

