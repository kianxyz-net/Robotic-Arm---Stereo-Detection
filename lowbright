        public bool CaptureDepthSample(Mat frame1, Mat frame2)
        {
            if (!IsDepthCalibrating || !IsCalibrated) return false;
            
            // Detect chessboard
            var boardSize = new Size(cornersX, cornersY);
            using var gray1 = new Mat();
            Cv2.CvtColor(frame1, gray1, ColorConversionCodes.BGR2GRAY);
            
            bool found = Cv2.FindChessboardCorners(gray1, boardSize, out Point2f[] corners,
                ChessboardFlags.AdaptiveThresh | ChessboardFlags.NormalizeImage);
            
            if (!found)
            {
                Console.WriteLine("Chessboard not found - hold it steady in view");
                return false;
            }
            
            Cv2.CornerSubPix(gray1, corners, new Size(11, 11), new Size(-1, -1),
                new TermCriteria(CriteriaTypes.Eps | CriteriaTypes.MaxIter, 30, 0.001));
            
            // Compute disparity for this frame
            using var disp = ComputeDisparity(frame1, frame2);
            if (disp == null || disp.Empty()) return false;
            
            using var dispFloat = new Mat();
            disp.ConvertTo(dispFloat, MatType.CV_32F, 1.0 / 16.0);
            
            // Find board center (average of all corners)
            float centerX = corners.Average(c => c.X);
            float centerY = corners.Average(c => c.Y);
            
            // Sample disparity at ALL chessboard corners (more robust)
            List<float> disparities = new();
            foreach (var corner in corners)
            {
                int x = (int)corner.X;
                int y = (int)corner.Y;
                if (x >= 0 && y >= 0 && x < dispFloat.Width && y < dispFloat.Height)
                {
                    float d = dispFloat.At<float>(y, x);
                    if (d > 0) disparities.Add(d);
                }
            }
            
            if (disparities.Count < 10)
            {
                Console.WriteLine($"Not enough valid disparity ({disparities.Count}/{corners.Length} corners) - may need to redo stereo calibration (T)");
                return false;
            }
            
            disparities.Sort();
            double medianDisparity = disparities[disparities.Count / 2];
            
            // Calculate camera 3D coords using theoretical formula (will be calibrated)
            double fx = P1!.At<double>(0, 0);
            double fy = P1.At<double>(1, 1);
            double cx = K1!.At<double>(0, 2);
            double cy = K1.At<double>(1, 2);
            double p2_03 = P2!.At<double>(0, 3);
            
            // Theoretical Z (will be corrected by depth calibration)
            double camZ = -p2_03 / medianDisparity;
            double camX = (centerX - cx) * camZ / fx;
            double camY = (centerY - cy) * camZ / fy;
            
            Console.WriteLine($"\nBoard center detected at camera coords:");
            Console.WriteLine($"  Pixel: ({centerX:F0}, {centerY:F0}), Disparity: {medianDisparity:F1}px");
            Console.WriteLine($"  Camera XYZ: ({camX:F0}, {camY:F0}, {camZ:F0}) mm (theoretical)");
            
            // Ask user for ACTUAL MEASURED DISTANCE (for depth calibration)
            Console.Write("Measured distance from CAMERA to board (mm): ");
            if (!double.TryParse(Console.ReadLine(), out double measuredDistance)) { Console.WriteLine("Invalid, discarded"); return false; }
            
            if (measuredDistance <= 0) { Console.WriteLine("Distance must be positive"); return false; }
            
            // Store depth sample (disparity -> measured distance)
            depthSamples.Add((medianDisparity, measuredDistance));
            
            Console.WriteLine($"\nSample {depthSamples.Count}: disparity {medianDisparity:F1}px -> {measuredDistance:F0}mm");
            return true;
        }
        
        public bool ComputeDepthCalibration()
        {
            if (depthSamples.Count < 4)
            {
                Console.WriteLine($"Need at least 4 samples, have {depthSamples.Count}");
                return false;
            }
            
            int n = depthSamples.Count;
            
            // ===== DEPTH CALIBRATION =====
            // Fit hyperbolic model: Z = Scale / (disparity + Offset)
            // Linear regression on: 1/Z = m*disparity + c
            double sumX = 0, sumY = 0, sumXY = 0, sumXX = 0;
            
            foreach (var (d, z) in depthSamples)
            {
                if (z <= 0) continue;
                double x = d;
                double y = 1.0 / z;
                sumX += x;
                sumY += y;
                sumXY += x * y;
                sumXX += x * x;
            }
            
            double m = (n * sumXY - sumX * sumY) / (n * sumXX - sumX * sumX);
            double c = (sumY - m * sumX) / n;
            DepthScale = 1.0 / m;
            DepthOffset = c / m;
            
            Console.WriteLine("\n===== DEPTH CALIBRATION COMPLETE =====");
            Console.WriteLine($"Formula: Z = {DepthScale:F1} / (disparity + {DepthOffset:F2})");
            IsDepthCalibrated = true;
            
            // Show calibration accuracy
            Console.WriteLine("\nCalibration check:");
            double totalError = 0;
            foreach (var (d, z) in depthSamples)
            {
                double predicted = DepthScale / (d + DepthOffset);
                double error = Math.Abs(predicted - z);
                totalError += error;
                Console.WriteLine($"  d={d:F1}px: measured={z:F0}mm, predicted={predicted:F0}mm, error={error:F0}mm");
            }
            Console.WriteLine($"Average error: {totalError / n:F1}mm");
            
            IsDepthCalibrating = false;
            SaveDepthCalibration();
            
            Console.WriteLine("\nDepth calibration saved!");
            Console.WriteLine("Now use r key for hand-eye (camera→robot) calibration.\n");
            return true;
        }
        
        // Transform camera coords to robot coords using calibrated transform
        public (double rx, double ry, double rz) TransformCameraToRobot(double cx, double cy, double cz)
        {
            if (!HasRobotTransform) return (cx, cy, cz);
            
            double rx = RotationMatrix[0] * cx + RotationMatrix[1] * cy + RotationMatrix[2] * cz + TranslationX;
            double ry = RotationMatrix[3] * cx + RotationMatrix[4] * cy + RotationMatrix[5] * cz + TranslationY;
            double rz = RotationMatrix[6] * cx + RotationMatrix[7] * cy + RotationMatrix[8] * cz + TranslationZ;
            
            return (rx, ry, rz);
        }
        
        private void SaveDepthCalibration()
        {
            try
            {
                using var fs = new FileStorage(DepthCalibFile, FileStorage.Modes.Write);
                fs.Write("DepthScale", DepthScale);
                fs.Write("DepthOffset", DepthOffset);
                
                // Save robot transform
                fs.Write("HasRobotTransform", HasRobotTransform ? 1 : 0);
                if (HasRobotTransform)
                {
                    fs.Write("TranslationX", TranslationX);
                    fs.Write("TranslationY", TranslationY);
                    fs.Write("TranslationZ", TranslationZ);
                    var rotMat = new Mat(3, 3, MatType.CV_64F);
                    for (int i = 0; i < 9; i++)
                        rotMat.Set(i / 3, i % 3, RotationMatrix[i]);
                    fs.Write("RotationMatrix", rotMat);
                    rotMat.Dispose();
                }
                
                Console.WriteLine($"Saved depth + robot calibration to {DepthCalibFile}");
            }
            catch (Exception ex) { Console.WriteLine($"Save failed: {ex.Message}"); }
        }
        
        private void LoadDepthCalibration()
        {
            if (!System.IO.File.Exists(DepthCalibFile)) return;
            try
            {
                using var fs = new FileStorage(DepthCalibFile, FileStorage.Modes.Read);
                
                // Load depth calibration
                try 
                {
                    DepthScale = fs["DepthScale"]?.ReadFloat() ?? 0;
                    DepthOffset = fs["DepthOffset"]?.ReadFloat() ?? 0;
                    
                    if (DepthScale > 0)
                    {
                        IsDepthCalibrated = true;
                        Console.WriteLine($"Loaded depth calibration: Z = {DepthScale:F1} / (d + {DepthOffset:F2})");
                    }
                }
                catch { Console.WriteLine("  (depth params missing or invalid)"); }
                
                // Robot transform from Kabsch is disabled - use legacy (R key) instead
                // Old HasRobotTransform data in file is ignored
                HasRobotTransform = false;
            }
            catch (Exception ex) 
            { 
                Console.WriteLine($"Load depth calib file error: {ex.Message}");
                Console.WriteLine("  Delete depth_calib.xml and redo calibration with E key");
            }
        }
        
        // Apply empirical depth correction
        public double ApplyDepthCalibration(double disparity)
        {
            if (!IsDepthCalibrated || disparity <= 0) return 0;
            return DepthScale / (disparity + DepthOffset);
        }
    }

    public class ModbusCoordinateServer
    {
        private ModbusServer? _server;
        private Thread? _serverThread;
        private readonly object _lock = new();

        public void Start(int port)
        {
            _server = new ModbusServer { Port = port };
            _serverThread = new Thread(() => { try { _server.Listen(); } catch { } }) { IsBackground = true };
            _serverThread.Start();
            Console.WriteLine($"Modbus server on port {port}");
        }

        // Check if robot has triggered (Register 8)
        public bool IsTriggerSet()
        {
            if (_server == null) return false;
            lock (_lock)
            {
                return _server.holdingRegisters[9] == 1;
            }
        }

        // Clear the trigger after processing
        public void ClearTrigger()
        {
            if (_server == null) return;
            lock (_lock)
            {
                _server.holdingRegisters[9] = 0;
            }
        }

        public void UpdateCoordinates(float x, float y, float z, int teaType = 0)
        {
            if (_server == null) return;
            
            lock (_lock)
            {
                // Register 0: X × 10 (scaled)
                _server.holdingRegisters[1] = (short)(x * 10);
                
                // Register 2: Y × 10 (scaled)
                _server.holdingRegisters[3] = (short)(y * 10);
                
                // Register 3: TeaType (1=green, 2=red)
                _server.holdingRegisters[4] = (short)teaType;
                
                // Register 4: Z × 10 (scaled)
                _server.holdingRegisters[5] = (short)(z * 10);
                
                // Register 6: Done flag (1 = coordinates ready)
                _server.holdingRegisters[7] = (short)(x != 0 || y != 0 ? 1 : 0);
            }
        }

        public void Dispose() => _server?.StopListening();
    }


    // Hand-eye calibration using point correspondences
    // Computes: robot = scale * R * camera + T (Umeyama algorithm)
    class RobotCalibration
    {
        private const string CalibFile = "robot_calib.xml";
        
        // Umeyama transform parameters
        public double Scale { get; private set; } = 1.0;
        public double[] RotationMatrix { get; private set; } = new double[9] { 1, 0, 0, 0, 1, 0, 0, 0, 1 };
        public double TranslationX { get; private set; } = 0;
        public double TranslationY { get; private set; } = 0;
        public double TranslationZ { get; private set; } = 0;
        
        public bool IsCalibrated { get; private set; }
        public bool IsCalibrating { get; private set; }
        
        // Point correspondences: (camera XYZ, robot XYZ)
        private List<(double cx, double cy, double cz, double rx, double ry, double rz)> points = new();
        
        // Pending camera point waiting for robot input
        private (double cx, double cy, double cz)? pendingCameraPoint = null;
        
        public RobotCalibration()
        {
            Load();
        }
        
        public void StartCalibration(StereoDepth stereo)
        {
            if (!stereo.IsCalibrated)
            {
                Console.WriteLine("ERROR: Run stereo calibration (T) first!");
                return;
            }
            
            Console.WriteLine("\n=== HAND-EYE CALIBRATION ===");
            Console.WriteLine("Collect 4+ point correspondences between camera and robot.");
            Console.WriteLine("");
            Console.WriteLine("For each point:");
            Console.WriteLine("  1. Place a can/bottle in robot workspace (must be detected by YOLO)");
            Console.WriteLine("  2. Press SPACE - camera captures TOP CENTER of object");
            Console.WriteLine("  3. Touch TOP CENTER of object with robot, enter robot XYZ");
            Console.WriteLine("  4. Move object to new position, repeat 4+ times");
            Console.WriteLine("  5. Press C to compute transform");
            Console.WriteLine("");
            Console.WriteLine("Tip: Use positions at different X, Y, and Z (heights/distances).\n");
            
            points.Clear();
            pendingCameraPoint = null;
            IsCalibrating = true;
        }
        
        public void ManualCalibration()
        {
            Console.WriteLine("\n=== MANUAL HAND-EYE CALIBRATION ===");
            Console.WriteLine("Enter point correspondences manually.");
            Console.WriteLine("Enter 'done' when finished (minimum 4 points).\n");
            
            points.Clear();
            int pointNum = 1;
            
            while (true)
            {
                Console.WriteLine($"--- Point {pointNum} ---");
                Console.Write("Camera X (or 'done'): ");
                string? input = Console.ReadLine();
                if (input?.ToLower() == "done") break;
                
                if (!double.TryParse(input, out double cx)) { Console.WriteLine("Invalid, try again"); continue; }
                Console.Write("Camera Y: ");
                if (!double.TryParse(Console.ReadLine(), out double cy)) { Console.WriteLine("Invalid, try again"); continue; }
                Console.Write("Camera Z: ");
                if (!double.TryParse(Console.ReadLine(), out double cz)) { Console.WriteLine("Invalid, try again"); continue; }
                
                Console.Write("Robot X: ");
                if (!double.TryParse(Console.ReadLine(), out double rx)) { Console.WriteLine("Invalid, try again"); continue; }
                Console.Write("Robot Y: ");
                if (!double.TryParse(Console.ReadLine(), out double ry)) { Console.WriteLine("Invalid, try again"); continue; }
                Console.Write("Robot Z: ");
                if (!double.TryParse(Console.ReadLine(), out double rz)) { Console.WriteLine("Invalid, try again"); continue; }
                
                points.Add((cx, cy, cz, rx, ry, rz));
                Console.WriteLine($"Point {pointNum} added: Camera({cx}, {cy}, {cz}) → Robot({rx}, {ry}, {rz})\n");
                pointNum++;
            }
            
            if (points.Count < 3)
            {
                Console.WriteLine($"Need at least 3 points, got {points.Count}. Calibration cancelled.");
                return;
            }
            
            ComputeCalibration();
        }
        
        public bool CapturePoint(Mat frame1, Mat frame2, StereoDepth stereo, List<DetectedObject> detections)
        {
            if (!IsCalibrating || !stereo.IsCalibrated) return false;
            
            // If we have a pending point, ask for robot coords
            if (pendingCameraPoint.HasValue)
            {
                var cam = pendingCameraPoint.Value;
                Console.WriteLine($"\nCamera point (TOP of object): ({cam.cx:F0}, {cam.cy:F0}, {cam.cz:F0}) mm");
                Console.WriteLine("Touch the TOP CENTER of the object with robot gripper.");
                Console.WriteLine("Enter robot coordinates from teach pendant:\n");
                
                Console.Write("Robot X (mm): ");
                if (!double.TryParse(Console.ReadLine(), out double rx)) { Console.WriteLine("Invalid, cancelled"); return false; }
                
                Console.Write("Robot Y (mm): ");
                if (!double.TryParse(Console.ReadLine(), out double ry)) { Console.WriteLine("Invalid, cancelled"); return false; }
                
                Console.Write("Robot Z (mm): ");
                if (!double.TryParse(Console.ReadLine(), out double rz)) { Console.WriteLine("Invalid, cancelled"); return false; }
                
                points.Add((cam.cx, cam.cy, cam.cz, rx, ry, rz));
                pendingCameraPoint = null;
                
                Console.WriteLine($"\nPoint {points.Count} captured:");
                Console.WriteLine($"  Camera: ({cam.cx:F0}, {cam.cy:F0}, {cam.cz:F0})");
                Console.WriteLine($"  Robot:  ({rx:F0}, {ry:F0}, {rz:F0})");
                Console.WriteLine($"\nNeed {Math.Max(0, 4 - points.Count)} more points. Press SPACE for next, C when done.\n");
                return true;
            }
            
            // Use YOLO detection instead of chessboard
            if (detections == null || detections.Count == 0)
            {
                Console.WriteLine("No object detected - place can in view");
                return false;
            }
            
            var det = detections[0];  // Use first detected object
            
            // Get bounding box center
            float centerX = det.BoundingBox.X + det.BoundingBox.Width / 2f;
            float centerY = det.BoundingBox.Y + det.BoundingBox.Height / 2f;
            
            // Get depth at center using stereo
            var (hasDepth, camX, camY, camZ) = stereo.GetPointDepth(frame1, frame2, centerX, centerY);
            
            if (!hasDepth || camZ <= 0)
            {
                Console.WriteLine("Could not compute depth - try adjusting object position");
                return false;
            }
            
            // Adjust Y to get TOP of object (camera Y+ is down)
            // half_height_mm = (bbox_height_pixels / 2) * Z / focal_length
            double f = stereo.GetFocalLength();
            double halfHeightPx = det.BoundingBox.Height / 2.0;
            double halfHeightMm = halfHeightPx * camZ / f;
            double topY = camY + halfHeightMm;  // Add because Y+ is up, top is higher Y
            
            pendingCameraPoint = (camX, topY, camZ);
            Console.WriteLine($"\n{det.Label} detected:");
            Console.WriteLine($"  BBox center: ({camX:F0}, {camY:F0}, {camZ:F0}) mm");
            Console.WriteLine($"  Height adjustment: +{halfHeightMm:F0} mm");
            Console.WriteLine($"  TOP of object: ({camX:F0}, {topY:F0}, {camZ:F0}) mm");
            Console.WriteLine("Press SPACE again to enter robot coordinates, or reposition and press SPACE to recapture.");
            return true;
        }
        
        // Color-based capture using triangulation (more accurate than YOLO bbox + disparity)
        public bool CapturePointWithColor(Mat frame1, Mat frame2, StereoDepth stereo, ColorDetector colorDetector)
        {
            if (!IsCalibrating || !stereo.IsCalibrated) return false;
            
            // If we have a pending point, ask for robot coords
            if (pendingCameraPoint.HasValue)
            {
                var cam = pendingCameraPoint.Value;
                Console.WriteLine($"\nCamera point: ({cam.cx:F0}, {cam.cy:F0}, {cam.cz:F0}) mm");
                Console.WriteLine("Touch the CENTER of the object with robot gripper.");
                Console.WriteLine("Enter robot coordinates from teach pendant:\n");
                
                Console.Write("Robot X (mm): ");
                if (!double.TryParse(Console.ReadLine(), out double rx)) { Console.WriteLine("Invalid, cancelled"); return false; }
                
                Console.Write("Robot Y (mm): ");
                if (!double.TryParse(Console.ReadLine(), out double ry)) { Console.WriteLine("Invalid, cancelled"); return false; }
                
                Console.Write("Robot Z (mm): ");
                if (!double.TryParse(Console.ReadLine(), out double rz)) { Console.WriteLine("Invalid, cancelled"); return false; }
                
                points.Add((cam.cx, cam.cy, cam.cz, rx, ry, rz));
                pendingCameraPoint = null;
                
                Console.WriteLine($"\nPoint {points.Count} captured:");
                Console.WriteLine($"  Camera: ({cam.cx:F0}, {cam.cy:F0}, {cam.cz:F0})");
                Console.WriteLine($"  Robot:  ({rx:F0}, {ry:F0}, {rz:F0})");
                Console.WriteLine($"\nNeed {Math.Max(0, 4 - points.Count)} more points. Press SPACE for next, C when done.\n");
                return true;
            }
            
            // Detect in RAW frames
            var (found1, raw1X, raw1Y, mask1) = colorDetector.DetectGreen(frame1);
            var (found2, raw2X, raw2Y, mask2) = colorDetector.DetectGreen(frame2);
            
            mask1?.Dispose();
            mask2?.Dispose();
            
            if (!found1 || !found2)
            {
                Console.WriteLine("Green object not detected in both cameras - ensure can is visible in both views");
                return false;
            }
            
            // Rectify the centroid points
            var (rect1X, rect1Y) = stereo.RectifyPoint(raw1X, raw1Y, true);
            var (rect2X, rect2Y) = stereo.RectifyPoint(raw2X, raw2Y, false);
            
            // Check Y difference (should be small for good rectification)
            float yDiff = Math.Abs(rect1Y - rect2Y);
            if (yDiff > 30)
            {
                Console.WriteLine($"Warning: Y difference = {yDiff:F1}px (should be < 30 for good match)");
            }
            
            // Compute depth from disparity
            float disparity = Math.Abs(rect1X - rect2X);
            var (success, x, y, z) = stereo.ComputeDepthFromDisparity(rect1X, rect1Y, disparity);
            
            if (!success || z <= 0)
            {
                Console.WriteLine($"Depth computation failed (disparity={disparity:F1}) - try repositioning object");
                return false;
            }
            
            pendingCameraPoint = (x, y, z);
            Console.WriteLine($"\nGreen object detected:");
            Console.WriteLine($"  Raw centroids: L({raw1X:F0}, {raw1Y:F0}) R({raw2X:F0}, {raw2Y:F0})");
            Console.WriteLine($"  Rectified: L({rect1X:F0}, {rect1Y:F0}) R({rect2X:F0}, {rect2Y:F0})");
            Console.WriteLine($"  Disparity: {disparity:F1}px, Y diff: {yDiff:F1}px");
            Console.WriteLine($"  3D position: ({x:F0}, {y:F0}, {z:F0}) mm");
            Console.WriteLine("Press SPACE again to enter robot coordinates, or reposition and press SPACE to recapture.");
            return true;
        }
        
        public bool ComputeCalibration()
        {
            if (points.Count < 3)
            {
                Console.WriteLine($"Need at least 3 points, have {points.Count}");
                return false;
            }
            
            Console.WriteLine($"\nComputing transform from {points.Count} points...");
            
            // Umeyama algorithm: finds scale, rotation, translation
            // that minimizes: sum || robot - (scale * R * camera + T) ||^2
            
            int n = points.Count;
            
            // Compute centroids
            double camCentX = points.Average(p => p.cx);
            double camCentY = points.Average(p => p.cy);
            double camCentZ = points.Average(p => p.cz);
            double robCentX = points.Average(p => p.rx);
            double robCentY = points.Average(p => p.ry);
            double robCentZ = points.Average(p => p.rz);
            
            // Compute variance of camera points (for scale)
            double camVar = 0;
            foreach (var p in points)
            {
                camVar += Math.Pow(p.cx - camCentX, 2) + Math.Pow(p.cy - camCentY, 2) + Math.Pow(p.cz - camCentZ, 2);
            }
            camVar /= n;
            
            // Build cross-covariance matrix H = sum of (robot_centered * camera_centered^T)
            double[,] H = new double[3, 3];
            foreach (var p in points)
            {
                double cx = p.cx - camCentX;
                double cy = p.cy - camCentY;
                double cz = p.cz - camCentZ;
                double rx = p.rx - robCentX;
                double ry = p.ry - robCentY;
                double rz = p.rz - robCentZ;
                
                // H = robot * camera^T (outer product)
                H[0, 0] += rx * cx; H[0, 1] += rx * cy; H[0, 2] += rx * cz;
                H[1, 0] += ry * cx; H[1, 1] += ry * cy; H[1, 2] += ry * cz;
                H[2, 0] += rz * cx; H[2, 1] += rz * cy; H[2, 2] += rz * cz;
            }
            
            // SVD of H
            using var HMat = new Mat(3, 3, MatType.CV_64FC1);
            for (int i = 0; i < 3; i++)
                for (int j = 0; j < 3; j++)
                    HMat.Set(i, j, H[i, j]);
            
            using var W = new Mat();
            using var U = new Mat();
            using var Vt = new Mat();
            Cv2.SVDecomp(HMat, W, U, Vt);
            
            // R = U * V^T (Vt is already V transposed from SVDecomp)
            using var R_mat = new Mat();
            using var emptyMat = new Mat();
            Cv2.Gemm(U, Vt, 1, emptyMat, 0, R_mat);
            
            // Check for reflection (det(R) should be +1)
            double det = Cv2.Determinant(R_mat);
            if (det < 0)
            {
                // Flip sign of last column of U
                for (int i = 0; i < 3; i++)
                    U.Set(i, 2, -U.At<double>(i, 2));
                Cv2.Gemm(U, Vt, 1, emptyMat, 0, R_mat);
            }
            
            // Store rotation matrix
            for (int i = 0; i < 3; i++)
                for (int j = 0; j < 3; j++)
                    RotationMatrix[i * 3 + j] = R_mat.At<double>(i, j);
            
            // Compute scale: scale = trace(D * S) / variance
            // Note: W contains singular values, camVar is already divided by n
            double traceRH = 0;
            for (int i = 0; i < 3; i++)
            {
                double sign = (i == 2 && det < 0) ? -1 : 1;
                traceRH += sign * W.At<double>(i, 0);
            }
            Scale = traceRH / (n * camVar);  // camVar = sum/n, so n*camVar = sum
            
            // Compute translation: T = robot_centroid - scale * R * camera_centroid
            double rcx = Scale * (RotationMatrix[0] * camCentX + RotationMatrix[1] * camCentY + RotationMatrix[2] * camCentZ);
            double rcy = Scale * (RotationMatrix[3] * camCentX + RotationMatrix[4] * camCentY + RotationMatrix[5] * camCentZ);
            double rcz = Scale * (RotationMatrix[6] * camCentX + RotationMatrix[7] * camCentY + RotationMatrix[8] * camCentZ);
            
            TranslationX = robCentX - rcx;
            TranslationY = robCentY - rcy;
            TranslationZ = robCentZ - rcz;
            
            // Print results
            Console.WriteLine("\n===== HAND-EYE CALIBRATION COMPLETE =====");
            Console.WriteLine($"Scale: {Scale:F4}");
            Console.WriteLine($"Translation: ({TranslationX:F1}, {TranslationY:F1}, {TranslationZ:F1}) mm");
            Console.WriteLine("Rotation matrix:");
            Console.WriteLine($"  [{RotationMatrix[0]:F4} {RotationMatrix[1]:F4} {RotationMatrix[2]:F4}]");
            Console.WriteLine($"  [{RotationMatrix[3]:F4} {RotationMatrix[4]:F4} {RotationMatrix[5]:F4}]");
            Console.WriteLine($"  [{RotationMatrix[6]:F4} {RotationMatrix[7]:F4} {RotationMatrix[8]:F4}]");
            
            // Calculate and show errors
            Console.WriteLine("\nCalibration errors:");
            double totalError = 0;
            for (int i = 0; i < points.Count; i++)
            {
                var p = points[i];
                var (predX, predY, predZ) = TransformToRobot((float)p.cx, (float)p.cy, (float)p.cz);
                double error = Math.Sqrt(Math.Pow(predX - p.rx, 2) + Math.Pow(predY - p.ry, 2) + Math.Pow(predZ - p.rz, 2));
                totalError += error;
                Console.WriteLine($"  Point {i + 1}: error = {error:F1} mm");
            }
            Console.WriteLine($"Average error: {totalError / n:F1} mm");
            
            IsCalibrating = false;
            IsCalibrated = true;
            pendingCameraPoint = null;
            Save();
            
            Console.WriteLine("\nCalibration saved to robot_calib.xml\n");
            return true;
        }
        
        public (float rx, float ry, float rz) TransformToRobot(float cx, float cy, float cz)
        {
            if (!IsCalibrated) return (cx, cy, cz);
            
            // Apply: robot = scale * R * camera + T
            double rx = Scale * (RotationMatrix[0] * cx + RotationMatrix[1] * cy + RotationMatrix[2] * cz) + TranslationX;
            double ry = Scale * (RotationMatrix[3] * cx + RotationMatrix[4] * cy + RotationMatrix[5] * cz) + TranslationY;
            double rz = Scale * (RotationMatrix[6] * cx + RotationMatrix[7] * cy + RotationMatrix[8] * cz) + TranslationZ;
            
            return ((float)rx, (float)ry, (float)rz);
        }
        
        private void Save()
        {
            try
            {
                using var fs = new FileStorage(CalibFile, FileStorage.Modes.Write);
                fs.Write("Scale", Scale);
                fs.Write("TranslationX", TranslationX);
                fs.Write("TranslationY", TranslationY);
                fs.Write("TranslationZ", TranslationZ);
                
                var rotMat = new Mat(3, 3, MatType.CV_64F);
                for (int i = 0; i < 9; i++)
                    rotMat.Set(i / 3, i % 3, RotationMatrix[i]);
                fs.Write("RotationMatrix", rotMat);
                rotMat.Dispose();
            }
            catch (Exception ex) { Console.WriteLine($"Save failed: {ex.Message}"); }
        }
        
        private void Load()
        {
            if (!System.IO.File.Exists(CalibFile)) return;
            try
            {
                using var fs = new FileStorage(CalibFile, FileStorage.Modes.Read);
                
                Scale = fs["Scale"]?.ReadFloat() ?? 1.0;
                TranslationX = fs["TranslationX"]?.ReadFloat() ?? 0;
                TranslationY = fs["TranslationY"]?.ReadFloat() ?? 0;
                TranslationZ = fs["TranslationZ"]?.ReadFloat() ?? 0;
                
                using var rotMat = fs["RotationMatrix"]?.ReadMat();
                if (rotMat != null && !rotMat.Empty())
                {
                    for (int i = 0; i < 9; i++)
                        RotationMatrix[i] = rotMat.At<double>(i / 3, i % 3);
                }
                
                IsCalibrated = true;
                Console.WriteLine($"Loaded hand-eye calibration (Scale: {Scale:F3}, T: {TranslationX:F0}, {TranslationY:F0}, {TranslationZ:F0})");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to load robot calibration: {ex.Message}");
            }
        }
    }

    class Program
    {
        static bool running = true;
        static Dictionary<string, (float x, float y, float z, int age)> lastDepth = new();
        static Dictionary<string, List<(float x, float y, float z)>> depthBuffer = new();
        const int MaxAge = 10;
        const int BufferSize = 7;
        static DateTime lastRobotPrint = DateTime.MinValue;
        static DateTime _lastTriangDebug = DateTime.MinValue;
        
        // Helper to expand a rectangle by a margin, clamped to image bounds
        static Rect ExpandRect(Rect r, int margin, int maxWidth, int maxHeight)
        {
            int x = Math.Max(0, r.X - margin);
            int y = Math.Max(0, r.Y - margin);
            int w = Math.Min(r.Width + 2 * margin, maxWidth - x);
            int h = Math.Min(r.Height + 2 * margin, maxHeight - y);
            return new Rect(x, y, w, h);
        }

        static void Main(string[] args)
        {
            Console.WriteLine("=== Stereo Vision: Color Detection ===\n");

            // Color detector for green object detection
            var colorDetector = new ColorDetector();

            var stereo = new StereoDepth();
            var robotCalib = new RobotCalibration();
            var modbus = new ModbusCoordinateServer();
            modbus.Start(502);

            int cam1 = 0, cam2 = 1;
            if (args.Length >= 2) { int.TryParse(args[0], out cam1); int.TryParse(args[1], out cam2); }

            Console.WriteLine($"Opening cameras {cam1} and {cam2}...");
            var cap1 = new VideoCapture(cam1, VideoCaptureAPIs.DSHOW);
            var cap2 = new VideoCapture(cam2, VideoCaptureAPIs.DSHOW);
            
            if (!cap1.IsOpened() || !cap2.IsOpened())
            {
                Console.WriteLine("Failed to open cameras");
                return;
            }

            cap1.Set(VideoCaptureProperties.FrameWidth, 640);
            cap1.Set(VideoCaptureProperties.FrameHeight, 480);
            cap2.Set(VideoCaptureProperties.FrameWidth, 640);
            cap2.Set(VideoCaptureProperties.FrameHeight, 480);
            
            // Disable auto-focus on both cameras for consistent stereo
            cap1.Set(VideoCaptureProperties.AutoFocus, 0);
            cap2.Set(VideoCaptureProperties.AutoFocus, 0);
            // Set fixed focus (0 = infinity, higher = closer) - adjust if needed
            cap1.Set(VideoCaptureProperties.Focus, 0);
            cap2.Set(VideoCaptureProperties.Focus, 0);
            
            // Match brightness/exposure between cameras
            // Bright overhead light setup - lower exposure to prevent overexposure
            cap1.Set(VideoCaptureProperties.AutoExposure, 0);
            cap2.Set(VideoCaptureProperties.AutoExposure, 0);
            cap1.Set(VideoCaptureProperties.Exposure, -6);  // Lower for bright light (-7 to -1)
            cap2.Set(VideoCaptureProperties.Exposure, -6);  // Match cam1
            cap1.Set(VideoCaptureProperties.Brightness, 100);  // 0-255
            cap2.Set(VideoCaptureProperties.Brightness, 100);  // Match cam1
            
            // Note: Cameras may have different zoom - stereo calibration handles this
            
            // Print current values to verify
            Console.WriteLine($"Cam1 - Zoom:{cap1.Get(VideoCaptureProperties.Zoom)} Exposure:{cap1.Get(VideoCaptureProperties.Exposure)} Brightness:{cap1.Get(VideoCaptureProperties.Brightness)}");
            Console.WriteLine($"Cam2 - Zoom:{cap2.Get(VideoCaptureProperties.Zoom)} Exposure:{cap2.Get(VideoCaptureProperties.Exposure)} Brightness:{cap2.Get(VideoCaptureProperties.Brightness)}");

            Console.WriteLine("Ready! T=stereo calib, r=hand-eye calib, R=manual calib, D=disparity, Q=quit\n");

            using var f1 = new Mat();
            using var f2 = new Mat();
            var w1 = new Window("Mask 1");
            var w2 = new Window("Mask 2");
            
            // Position windows side by side
            Cv2.MoveWindow("Mask 1", 0, 0);
            Cv2.MoveWindow("Mask 2", 660, 0);
            
            Window? dw = null;
            bool showDisp = false;

            Console.CancelKeyPress += (_, e) => { e.Cancel = true; running = false; };

            while (running)
            {
                // Grab both frames as close together as possible for better sync
                cap1.Grab(); cap2.Grab();
                if (!cap1.Retrieve(f1) || !cap2.Retrieve(f2)) continue;
                if (f1.Empty() || f2.Empty()) continue;

                // === COLOR DETECTION ON RAW FRAMES ===
                
                float finalX = 0, finalY = 0, finalZ = 0;
                int teaType = 0;  // 0=none, 1=green, 2=red
                bool hasDetection = false;
                float cent1X = 0, cent1Y = 0, cent2X = 0, cent2Y = 0;
                Mat? mask1 = null, mask2 = null;
                
                // Detect color (green or red) in both RAW frames
                var (found1, raw1X, raw1Y, tea1, m1) = colorDetector.DetectColor(f1);
                var (found2, raw2X, raw2Y, tea2, m2) = colorDetector.DetectColor(f2);
                mask1 = m1;
                mask2 = m2;
                
                // Store RAW centroids for display immediately
                if (found1) { cent1X = raw1X; cent1Y = raw1Y; }
                if (found2) { cent2X = raw2X; cent2Y = raw2Y; }
                
                // Both cameras must see the same color
                // Both cameras must detect something (colors can differ)
                if (stereo.IsCalibrated && found1 && found2)
                {
                    teaType = tea1;  // Use camera 1's color
                    
                    // Rectify the centroid points (not the whole frame)
                    var (rect1X, rect1Y) = stereo.RectifyPoint(raw1X, raw1Y, true);
                    var (rect2X, rect2Y) = stereo.RectifyPoint(raw2X, raw2Y, false);
                    
                    // Check Y alignment (should be similar after rectification)
                    float yDiff = Math.Abs(rect1Y - rect2Y);
                    float disparity = Math.Abs(rect1X - rect2X);
                    
                    if (yDiff < 100)  // Relaxed threshold for calibration variance
                    {
                        if (disparity > 5)  // Minimum disparity threshold
                        {
                            // Use disparity-based depth
                            var (success, x, y, z) = stereo.ComputeDepthFromDisparity(rect1X, rect1Y, disparity);
                            
                            if (success)
                            {
                                // Add to buffer for smoothing
                                string label = teaType == 1 ? "green" : "red";
                                if (!depthBuffer.ContainsKey(label))
                                    depthBuffer[label] = new List<(float, float, float)>();
                                
                                depthBuffer[label].Add((x, y, z));
                                if (depthBuffer[label].Count > BufferSize)
                                    depthBuffer[label].RemoveAt(0);
                                
                                // Use median of buffer
                                var buf = depthBuffer[label];
                                var xs = buf.Select(b => b.x).OrderBy(v => v).ToList();
                                var ys = buf.Select(b => b.y).OrderBy(v => v).ToList();
                                var zs = buf.Select(b => b.z).OrderBy(v => v).ToList();
                                
                                finalX = xs[xs.Count / 2];
                                finalY = ys[ys.Count / 2];
                                finalZ = zs[zs.Count / 2];
                                hasDetection = true;
                                
                                // Store RAW centroids for display
                                cent1X = raw1X; cent1Y = raw1Y;
                                cent2X = raw2X; cent2Y = raw2Y;
                                
                                lastDepth[label] = (finalX, finalY, finalZ, 0);
                                
                                // Debug output (every 3 sec)
                                if (!stereo.QuietMode && !stereo.IsCapturing && (DateTime.Now - _lastTriangDebug).TotalSeconds >= 3)
                                {
                                    Console.WriteLine($"Raw: L({raw1X:F0},{raw1Y:F0}) R({raw2X:F0},{raw2Y:F0})");
                                    Console.WriteLine($"Rect: L({rect1X:F0},{rect1Y:F0}) R({rect2X:F0},{rect2Y:F0}) disp={disparity:F1} yDiff={yDiff:F1}");
                                    Console.WriteLine($"3D: ({x:F0}, {y:F0}, {z:F0})mm [{label}]");
                                    _lastTriangDebug = DateTime.Now;
                                }
                            }
                        }
                    }
                }
                
                // Fall back to last known position if no current detection
                if (!hasDetection)
                {
                    // Check both colors for last known position
                    if (lastDepth.TryGetValue("green", out var lastGreen) && lastGreen.age < MaxAge)
                    {
                        finalX = lastGreen.x; finalY = lastGreen.y; finalZ = lastGreen.z;
                        teaType = 1;
                        hasDetection = true;
                        lastDepth["green"] = (lastGreen.x, lastGreen.y, lastGreen.z, lastGreen.age + 1);
                    }
                    else if (lastDepth.TryGetValue("red", out var lastRed) && lastRed.age < MaxAge)
                    {
                        finalX = lastRed.x; finalY = lastRed.y; finalZ = lastRed.z;
                        teaType = 2;
                        hasDetection = true;
                        lastDepth["red"] = (lastRed.x, lastRed.y, lastRed.z, lastRed.age + 1);
                    }
                }

                // Compute disparity only for display (if enabled)
                Mat? disp = null;
                if (showDisp && stereo.IsCalibrated)
                {
                    disp = stereo.ComputeDisparity(f1, f2);
                }

                // Update Modbus and console with robot coordinates
                if (hasDetection)
                {
                    // Cameras mounted above - seeing top of box directly
                    // No offsets needed - centroid IS the pick point
                    
                    // Transform camera coords to robot coords
                    var (rx, ry, rz) = robotCalib.TransformToRobot(finalX, finalY, finalZ);
                    
                    // Send robot coords + teaType to Modbus
                    modbus.UpdateCoordinates(rx, ry, rz, teaType);
                    
                    // Print to console periodically (every 3 seconds) - but not during calibration
                    string colorName = teaType == 1 ? "GREEN" : teaType == 2 ? "RED" : "???";
                    if (!stereo.QuietMode && !stereo.IsCapturing && !robotCalib.IsCalibrating && 
                        robotCalib.IsCalibrated && (DateTime.Now - lastRobotPrint).TotalSeconds >= 3)
                    {
                        Console.WriteLine($"{colorName} box: Camera({finalX:F0}, {finalY:F0}, {finalZ:F0}) → Robot({rx:F0}, {ry:F0}, {rz:F0})");
                        lastRobotPrint = DateTime.Now;
                    }
                }
                else
                {
                    modbus.UpdateCoordinates(0, 0, 0, 0);
                }

                if (stereo.IsCapturing)
                {
                    Cv2.PutText(f1, $"Stereo Captures: {stereo.CaptureCount}", new Point(10, 105), HersheyFonts.HersheySimplex, 0.5, Scalar.Cyan, 1);
                    Cv2.PutText(f2, $"Captures: {stereo.CaptureCount}", new Point(10, 25), HersheyFonts.HersheySimplex, 0.5, Scalar.Cyan, 1);
                }
                
                if (robotCalib.IsCalibrating)
                {
                    Cv2.PutText(f1, "Hand-Eye Calib: SPACE=capture, C=compute", new Point(10, 130), HersheyFonts.HersheySimplex, 0.5, Scalar.Cyan, 1);
                }

                if (showDisp && disp != null && !disp.Empty())
                {
                    using var vis = new Mat();
                    // numDisparities=256, raw values scaled by 16
                    disp.ConvertTo(vis, MatType.CV_8U, 255.0 / (256 * 16));
                    Cv2.ApplyColorMap(vis, vis, ColormapTypes.Jet);
                    dw ??= new Window("Disparity");
                    dw.ShowImage(vis);
                }
                disp?.Dispose();

                // Show masks with centroids drawn (unless stereo calibrating - then show raw)
                if (stereo.IsCapturing)
                {
                    // During stereo calibration, show raw frames so user can see chessboard
                    w1.ShowImage(f1);
                    w2.ShowImage(f2);
                    mask1?.Dispose();
                    mask2?.Dispose();
                }
                else
                {
                    // Normal mode - show masks
                    if (mask1 != null && !mask1.Empty())
                    {
                        using var mask1Color = new Mat();
                        Cv2.CvtColor(mask1, mask1Color, ColorConversionCodes.GRAY2BGR);
                        
                        // Draw centroid on mask
                        if (found1)
                            Cv2.Circle(mask1Color, new Point((int)cent1X, (int)cent1Y), 8, new Scalar(0, 0, 255), -1);
                        
                        // Draw status text with color type
                        string colorLabel = teaType == 1 ? "GREEN" : teaType == 2 ? "RED" : "";
                        string status = hasDetection ? $"Detected {colorLabel}" : (found1 && found2 ? "Color mismatch" : "Searching...");
                        Cv2.PutText(mask1Color, status, new Point(10, 30), HersheyFonts.HersheySimplex, 0.7, 
                            hasDetection ? new Scalar(0, 255, 0) : new Scalar(0, 0, 255), 2);
                        
                        if (hasDetection)
                        {
                            string coordText = $"({finalX:F0}, {finalY:F0}, {finalZ:F0})mm T={teaType}";
                            Cv2.PutText(mask1Color, coordText, new Point(10, 60), HersheyFonts.HersheySimplex, 0.6, new Scalar(0, 255, 255), 2);
                        }
                        
                        w1.ShowImage(mask1Color);
                        mask1.Dispose();
                    }
                    else
                    {
                        w1.ShowImage(f1);
                    }
                    
                    if (mask2 != null && !mask2.Empty())
                    {
                        using var mask2Color = new Mat();
                        Cv2.CvtColor(mask2, mask2Color, ColorConversionCodes.GRAY2BGR);
                        
                        // Draw centroid on mask
                        if (found2)
                            Cv2.Circle(mask2Color, new Point((int)cent2X, (int)cent2Y), 8, new Scalar(0, 0, 255), -1);
                        
                        w2.ShowImage(mask2Color);
                        mask2.Dispose();
                    }
                    else
                    {
                        w2.ShowImage(f2);
                    }
                }

                int k = Cv2.WaitKey(1);
                if (k == 'q' || k == 'Q' || k == 27) break;
                if (k == 't' || k == 'T') stereo.StartCalibration();
                if (k == 'r') { robotCalib.StartCalibration(stereo); stereo.QuietMode = true; }
                if (k == 'R') { robotCalib.ManualCalibration(); stereo.QuietMode = false; }  // Shift+R = manual entry
                if (k == ' ')
                {
                    if (stereo.IsCapturing) 
                        stereo.CaptureCalibrationFrame(f1, f2);
                    else if (robotCalib.IsCalibrating) 
                        robotCalib.CapturePointWithColor(f1, f2, stereo, colorDetector);
                }
                if (k == 'c' || k == 'C')
                {
                    if (stereo.IsCapturing) stereo.ComputeCalibration();
                    else if (robotCalib.IsCalibrating) { robotCalib.ComputeCalibration(); stereo.QuietMode = false; }
                }
                if (k == 'd' || k == 'D') { showDisp = !showDisp; if (!showDisp) { dw?.Dispose(); dw = null; } }
                if (k == 's' || k == 'S')
                {
                    var ts = DateTime.Now.ToString("yyyyMMdd_HHmmss");
                    Cv2.ImWrite($"cam1_{ts}.jpg", f1);
                    Cv2.ImWrite($"cam2_{ts}.jpg", f2);
                    Console.WriteLine("Saved");
                }
                if (k == 'v' || k == 'V')
                {
                    stereo.SaveRectifiedImages(f1, f2);
                }
            }

            dw?.Dispose();
            cap1.Release(); cap1.Dispose();
            cap2.Release(); cap2.Dispose();
            modbus.Dispose();
            
            try { Cv2.DestroyAllWindows(); } catch { }
        }
    }
}
