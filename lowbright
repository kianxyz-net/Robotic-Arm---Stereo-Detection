            }
            
            Console.WriteLine("\n=== DEPTH CALIBRATION ===");
            Console.WriteLine("Calibrates stereo depth using measured ground-truth distances.");
            Console.WriteLine("");
            Console.WriteLine("Steps:");
            Console.WriteLine("  1. Place chessboard at a known distance from camera");
            Console.WriteLine("  2. Measure distance from camera lens to board (tape measure)");
            Console.WriteLine("  3. Press SPACE to capture, then enter measured distance in mm");
            Console.WriteLine("  4. Repeat at 4+ DIFFERENT distances (spread from near to far)");
