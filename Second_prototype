            cap1.Set(VideoCaptureProperties.Exposure, -6);
            cap2.Set(VideoCaptureProperties.Exposure, -6);
            cap1.Set(VideoCaptureProperties.Brightness, 100);
            cap2.Set(VideoCaptureProperties.Brightness, 100);

            Console.WriteLine($"Cam1 - Zoom:{cap1.Get(VideoCaptureProperties.Zoom)} AutoExposure:{cap1.Get(VideoCaptureProperties.AutoExposure)} Exposure:{cap1.Get(VideoCaptureProperties.Exposure)} Brightness:{cap1.Get(VideoCaptureProperties.Brightness)}");
            Console.WriteLine($"Cam2 - Zoom:{cap2.Get(VideoCaptureProperties.Zoom)} AutoExposure:{cap2.Get(VideoCaptureProperties.AutoExposure)} Exposure:{cap2.Get(VideoCaptureProperties.Exposure)} Brightness:{cap2.Get(VideoCaptureProperties.Brightness)}");

            Console.WriteLine("Ready! T=stereo calib, r=hand-eye calib, R=manual calib, D=disparity, Q=quit\n");

            using var f1 = new Mat();
            using var f2 = new Mat();
            var w1 = new Window("Mask 1");
            var w2 = new Window("Mask 2");

            Cv2.MoveWindow("Mask 1", 0, 0);
            Cv2.MoveWindow("Mask 2", 660, 0);

            // === EXPOSURE/BRIGHTNESS SLIDERS (per camera) ===
            int exp1Slider = 1;   // -6
            int exp2Slider = 1;   // -6
            int bright1Slider = 100;
            int bright2Slider = 100;

            Cv2.CreateTrackbar("Exposure", "Mask 1", ref exp1Slider, 14);
            Cv2.CreateTrackbar("Exposure", "Mask 2", ref exp2Slider, 14);
            Cv2.CreateTrackbar("Brightness", "Mask 1", ref bright1Slider, 255);
            Cv2.CreateTrackbar("Brightness", "Mask 2", ref bright2Slider, 255);

            Window? dw = null;
            bool showDisp = false;

            Console.CancelKeyPress += (_, e) => { e.Cancel = true; running = false; };

            while (running)
            {
                // Poll sliders and apply live exposure/brightness per camera
                int curExp1 = Cv2.GetTrackbarPos("Exposure", "Mask 1") - 7;
                int curExp2 = Cv2.GetTrackbarPos("Exposure", "Mask 2") - 7;
                int curBright1 = Cv2.GetTrackbarPos("Brightness", "Mask 1");
                int curBright2 = Cv2.GetTrackbarPos("Brightness", "Mask 2");

                cap1.Set(VideoCaptureProperties.Exposure, curExp1);
                cap2.Set(VideoCaptureProperties.Exposure, curExp2);
                cap1.Set(VideoCaptureProperties.Brightness, curBright1);
                cap2.Set(VideoCaptureProperties.Brightness, curBright2);

                cap1.Grab(); cap2.Grab();
                if (!cap1.Retrieve(f1) || !cap2.Retrieve(f2)) continue;
                if (f1.Empty() || f2.Empty()) continue;

                // Apply configurable edge masking (0% = no effect) before any detection runs
                ApplyEdgeMask(f1, EdgeMaskPercent);
                ApplyEdgeMask(f2, EdgeMaskPercent);

                // === HIERARCHICAL COLOR DETECTION ON RAW FRAMES ===

                float finalX = 0, finalY = 0, finalZ = 0;
                int teaType = 0;
                bool hasDetection = false;
                float cent1X = 0, cent1Y = 0, cent2X = 0, cent2Y = 0;
                Mat? mask1 = null, mask2 = null;

                var (found1, raw1X, raw1Y, tea1, m1) = colorDetector.DetectColor(f1);
                var (found2, raw2X, raw2Y, tea2, m2) = colorDetector.DetectColor(f2);
                mask1 = m1;
                mask2 = m2;

                if (found1) { cent1X = raw1X; cent1Y = raw1Y; }
                if (found2) { cent2X = raw2X; cent2Y = raw2Y; }

                // Both cameras must detect a color; teaType from cam1 wins.
                if (stereo.IsCalibrated && found1 && found2)
                {
                    teaType = tea1;

                    var (rect1X, rect1Y) = stereo.RectifyPoint(raw1X, raw1Y, true);
                    var (rect2X, rect2Y) = stereo.RectifyPoint(raw2X, raw2Y, false);

                    float yDiff = Math.Abs(rect1Y - rect2Y);
                    float disparity = Math.Abs(rect1X - rect2X);

                    if (yDiff < 100)
                    {
                        if (disparity > 5)
                        {
                            var (success, x, y, z) = stereo.ComputeDepthFromDisparity(rect1X, rect1Y, disparity);

                            if (success)
                            {
                                string label = "t" + teaType;
                                if (!depthBuffer.ContainsKey(label))
                                    depthBuffer[label] = new List<(float, float, float)>();

                                depthBuffer[label].Add((x, y, z));
                                if (depthBuffer[label].Count > BufferSize)
                                    depthBuffer[label].RemoveAt(0);

                                var buf = depthBuffer[label];
                                var xs = buf.Select(b => b.x).OrderBy(v => v).ToList();
                                var ys = buf.Select(b => b.y).OrderBy(v => v).ToList();
                                var zs = buf.Select(b => b.z).OrderBy(v => v).ToList();

                                finalX = xs[xs.Count / 2];
                                finalY = ys[ys.Count / 2];
                                finalZ = zs[zs.Count / 2];
                                hasDetection = true;

                                cent1X = raw1X; cent1Y = raw1Y;
                                cent2X = raw2X; cent2Y = raw2Y;

                                lastDepth[label] = (finalX, finalY, finalZ, 0);

                                if (!stereo.QuietMode && !stereo.IsCapturing && (DateTime.Now - _lastTriangDebug).TotalSeconds >= 3)
                                {
                                    Console.WriteLine($"Raw: L({raw1X:F0},{raw1Y:F0}) R({raw2X:F0},{raw2Y:F0}) [L=t{tea1}, R=t{tea2}]");
                                    Console.WriteLine($"Rect: L({rect1X:F0},{rect1Y:F0}) R({rect2X:F0},{rect2Y:F0}) disp={disparity:F1} yDiff={yDiff:F1}");
                                    Console.WriteLine($"3D: ({x:F0}, {y:F0}, {z:F0})mm [teaType={teaType}]");
                                    _lastTriangDebug = DateTime.Now;
                                }
                            }
                        }
                    }
                }

                // Fall back to last known position if no current detection
                if (!hasDetection)
                {
                    if (lastDepth.TryGetValue("t1", out var last1) && last1.age < MaxAge)
                    {
                        finalX = last1.x; finalY = last1.y; finalZ = last1.z;
                        teaType = 1;
                        hasDetection = true;
                        lastDepth["t1"] = (last1.x, last1.y, last1.z, last1.age + 1);
                    }
                    else if (lastDepth.TryGetValue("t2", out var last2) && last2.age < MaxAge)
                    {
                        finalX = last2.x; finalY = last2.y; finalZ = last2.z;
                        teaType = 2;
                        hasDetection = true;
                        lastDepth["t2"] = (last2.x, last2.y, last2.z, last2.age + 1);
                    }
                }

                Mat? disp = null;
                if (showDisp && stereo.IsCalibrated)
                {
                    disp = stereo.ComputeDisparity(f1, f2);
                }

                if (hasDetection)
                {
                    var (rx, ry, rz) = robotCalib.TransformToRobot(finalX, finalY, finalZ);
                    modbus.UpdateCoordinates(rx, ry, rz, teaType);

                    string colorName = GetTeaTypeName(teaType);
                    if (!stereo.QuietMode && !stereo.IsCapturing && !robotCalib.IsCalibrating &&
                        robotCalib.IsCalibrated && (DateTime.Now - lastRobotPrint).TotalSeconds >= 3)
                    {
                        Console.WriteLine($"{colorName} (teaType={teaType}): Camera({finalX:F0}, {finalY:F0}, {finalZ:F0}) → Robot({rx:F0}, {ry:F0}, {rz:F0})");
                        lastRobotPrint = DateTime.Now;
                    }
                }
                else
                {
                    modbus.UpdateCoordinates(0, 0, 0, 0);
                }

                if (stereo.IsCapturing)
                {
                    Cv2.PutText(f1, $"Stereo Captures: {stereo.CaptureCount}", new Point(10, 105), HersheyFonts.HersheySimplex, 0.5, Scalar.Cyan, 1);
                    Cv2.PutText(f2, $"Captures: {stereo.CaptureCount}", new Point(10, 25), HersheyFonts.HersheySimplex, 0.5, Scalar.Cyan, 1);
                }

                if (robotCalib.IsCalibrating)
                {
                    Cv2.PutText(f1, "Hand-Eye Calib: SPACE=capture, C=compute", new Point(10, 130), HersheyFonts.HersheySimplex, 0.5, Scalar.Cyan, 1);
                }

                if (showDisp && disp != null && !disp.Empty())
                {
                    using var vis = new Mat();
                    disp.ConvertTo(vis, MatType.CV_8U, 255.0 / (256 * 16));
                    Cv2.ApplyColorMap(vis, vis, ColormapTypes.Jet);
                    dw ??= new Window("Disparity");
                    dw.ShowImage(vis);
                }
                disp?.Dispose();

                if (stereo.IsCapturing)
                {
                    w1.ShowImage(f1);
                    w2.ShowImage(f2);
                    mask1?.Dispose();
                    mask2?.Dispose();
                }
                else
                {
                    if (mask1 != null && !mask1.Empty())
                    {
                        using var mask1Color = new Mat();
                        Cv2.CvtColor(mask1, mask1Color, ColorConversionCodes.GRAY2BGR);

                        if (found1)
                            Cv2.Circle(mask1Color, new Point((int)cent1X, (int)cent1Y), 8, new Scalar(0, 0, 255), -1);

                        string colorLabel = GetTeaTypeName(teaType);
                        string status = hasDetection ? $"Detected teaType={teaType} ({colorLabel})"
                                                     : (found1 && found2 ? "Depth failed" : "Searching...");
                        Cv2.PutText(mask1Color, status, new Point(10, 30), HersheyFonts.HersheySimplex, 0.7,
                            hasDetection ? new Scalar(0, 255, 0) : new Scalar(0, 0, 255), 2);

                        if (hasDetection)
                        {
                            string coordText = $"({finalX:F0}, {finalY:F0}, {finalZ:F0})mm T={teaType}";
                            Cv2.PutText(mask1Color, coordText, new Point(10, 60), HersheyFonts.HersheySimplex, 0.6, new Scalar(0, 255, 255), 2);
                        }

                        w1.ShowImage(mask1Color);
                        mask1.Dispose();
                    }
                    else
                    {
                        w1.ShowImage(f1);
                    }

                    if (mask2 != null && !mask2.Empty())
                    {
                        using var mask2Color = new Mat();
                        Cv2.CvtColor(mask2, mask2Color, ColorConversionCodes.GRAY2BGR);

                        if (found2)
                            Cv2.Circle(mask2Color, new Point((int)cent2X, (int)cent2Y), 8, new Scalar(0, 0, 255), -1);

                        w2.ShowImage(mask2Color);
                        mask2.Dispose();
                    }
                    else
                    {
                        w2.ShowImage(f2);
                    }
                }

                int k = Cv2.WaitKey(1);
                if (k == 'q' || k == 'Q' || k == 27) break;
                if (k == 't' || k == 'T') stereo.StartCalibration();
                if (k == 'r') { robotCalib.StartCalibration(stereo); stereo.QuietMode = true; }
                if (k == 'R') { robotCalib.ManualCalibration(); stereo.QuietMode = false; }
                if (k == ' ')
                {
                    if (stereo.IsCapturing)
                        stereo.CaptureCalibrationFrame(f1, f2);
                    else if (robotCalib.IsCalibrating)
                        robotCalib.CapturePointWithColor(f1, f2, stereo, colorDetector);
                }
                if (k == 'c' || k == 'C')
                {
                    if (stereo.IsCapturing) stereo.ComputeCalibration();
                    else if (robotCalib.IsCalibrating) { robotCalib.ComputeCalibration(); stereo.QuietMode = false; }
                }
                if (k == 'd' || k == 'D') { showDisp = !showDisp; if (!showDisp) { dw?.Dispose(); dw = null; } }
                if (k == 's' || k == 'S')
                {
                    var ts = DateTime.Now.ToString("yyyyMMdd_HHmmss");
                    Cv2.ImWrite($"cam1_{ts}.jpg", f1);
                    Cv2.ImWrite($"cam2_{ts}.jpg", f2);
                    Console.WriteLine("Saved");
                }
                if (k == 'v' || k == 'V')
                {
                    stereo.SaveRectifiedImages(f1, f2);
                }
            }

            dw?.Dispose();
            cap1.Release(); cap1.Dispose();
            cap2.Release(); cap2.Dispose();
            modbus.Dispose();

            try { Cv2.DestroyAllWindows(); } catch { }
        }
    }
}
