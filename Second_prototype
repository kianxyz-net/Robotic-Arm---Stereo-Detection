        }

        public bool CaptureDepthSample(Mat frame1, Mat frame2)
        {
            if (!IsDepthCalibrating || !IsCalibrated) return false;

            var boardSize = new Size(cornersX, cornersY);
            using var gray1 = new Mat();
            Cv2.CvtColor(frame1, gray1, ColorConversionCodes.BGR2GRAY);

            bool found = Cv2.FindChessboardCorners(gray1, boardSize, out Point2f[] corners,
                ChessboardFlags.AdaptiveThresh | ChessboardFlags.NormalizeImage);

            if (!found)
            {
                Console.WriteLine("Chessboard not found - hold it steady in view");
                return false;
            }

            Cv2.CornerSubPix(gray1, corners, new Size(11, 11), new Size(-1, -1),
                new TermCriteria(CriteriaTypes.Eps | CriteriaTypes.MaxIter, 30, 0.001));

            using var disp = ComputeDisparity(frame1, frame2);
            if (disp == null || disp.Empty()) return false;

            using var dispFloat = new Mat();
            disp.ConvertTo(dispFloat, MatType.CV_32F, 1.0 / 16.0);

            float centerX = corners.Average(c => c.X);
            float centerY = corners.Average(c => c.Y);

            List<float> disparities = new();
            foreach (var corner in corners)
            {
                int x = (int)corner.X;
                int y = (int)corner.Y;
                if (x >= 0 && y >= 0 && x < dispFloat.Width && y < dispFloat.Height)
                {
                    float d = dispFloat.At<float>(y, x);
                    if (d > 0) disparities.Add(d);
                }
            }

            if (disparities.Count < 10)
            {
                Console.WriteLine($"Not enough valid disparity ({disparities.Count}/{corners.Length} corners) - may need to redo stereo calibration (T)");
                return false;
            }

            disparities.Sort();
            double medianDisparity = disparities[disparities.Count / 2];

            double fx = P1!.At<double>(0, 0);
            double fy = P1.At<double>(1, 1);
            double cx = K1!.At<double>(0, 2);
            double cy = K1.At<double>(1, 2);
            double p2_03 = P2!.At<double>(0, 3);

            double camZ = -p2_03 / medianDisparity;
            double camX = (centerX - cx) * camZ / fx;
            double camY = (centerY - cy) * camZ / fy;

            Console.WriteLine($"\nBoard center detected at camera coords:");
            Console.WriteLine($"  Pixel: ({centerX:F0}, {centerY:F0}), Disparity: {medianDisparity:F1}px");
            Console.WriteLine($"  Camera XYZ: ({camX:F0}, {camY:F0}, {camZ:F0}) mm (theoretical)");

            Console.Write("Measured distance from CAMERA to board (mm): ");
            if (!double.TryParse(Console.ReadLine(), out double measuredDistance)) { Console.WriteLine("Invalid, discarded"); return false; }

            if (measuredDistance <= 0) { Console.WriteLine("Distance must be positive"); return false; }

            depthSamples.Add((medianDisparity, measuredDistance));

            Console.WriteLine($"\nSample {depthSamples.Count}: disparity {medianDisparity:F1}px -> {measuredDistance:F0}mm");
            return true;
        }

        public bool ComputeDepthCalibration()
        {
            if (depthSamples.Count < 4)
            {
                Console.WriteLine($"Need at least 4 samples, have {depthSamples.Count}");
                return false;
            }

            int n = depthSamples.Count;

            double sumX = 0, sumY = 0, sumXY = 0, sumXX = 0;

            foreach (var (d, z) in depthSamples)
            {
                if (z <= 0) continue;
                double x = d;
                double y = 1.0 / z;
                sumX += x;
                sumY += y;
                sumXY += x * y;
                sumXX += x * x;
            }

            double m = (n * sumXY - sumX * sumY) / (n * sumXX - sumX * sumX);
            double c = (sumY - m * sumX) / n;
            DepthScale = 1.0 / m;
            DepthOffset = c / m;

            Console.WriteLine("\n===== DEPTH CALIBRATION COMPLETE =====");
            Console.WriteLine($"Formula: Z = {DepthScale:F1} / (disparity + {DepthOffset:F2})");
            IsDepthCalibrated = true;

            Console.WriteLine("\nCalibration check:");
            double totalError = 0;
            foreach (var (d, z) in depthSamples)
            {
                double predicted = DepthScale / (d + DepthOffset);
                double error = Math.Abs(predicted - z);
                totalError += error;
                Console.WriteLine($"  d={d:F1}px: measured={z:F0}mm, predicted={predicted:F0}mm, error={error:F0}mm");
            }
            Console.WriteLine($"Average error: {totalError / n:F1}mm");

            IsDepthCalibrating = false;
            SaveDepthCalibration();

            Console.WriteLine("\nDepth calibration saved!");
            Console.WriteLine("Now use r key for hand-eye (camera→robot) calibration.\n");
            return true;
        }

        public (double rx, double ry, double rz) TransformCameraToRobot(double cx, double cy, double cz)
        {
            if (!HasRobotTransform) return (cx, cy, cz);

            double rx = RotationMatrix[0] * cx + RotationMatrix[1] * cy + RotationMatrix[2] * cz + TranslationX;
            double ry = RotationMatrix[3] * cx + RotationMatrix[4] * cy + RotationMatrix[5] * cz + TranslationY;
            double rz = RotationMatrix[6] * cx + RotationMatrix[7] * cy + RotationMatrix[8] * cz + TranslationZ;

            return (rx, ry, rz);
        }

        private void SaveDepthCalibration()
        {
            try
            {
                using var fs = new FileStorage(DepthCalibFile, FileStorage.Modes.Write);
                fs.Write("DepthScale", DepthScale);
                fs.Write("DepthOffset", DepthOffset);

                fs.Write("HasRobotTransform", HasRobotTransform ? 1 : 0);
                if (HasRobotTransform)
                {
                    fs.Write("TranslationX", TranslationX);
                    fs.Write("TranslationY", TranslationY);
                    fs.Write("TranslationZ", TranslationZ);
                    var rotMat = new Mat(3, 3, MatType.CV_64F);
                    for (int i = 0; i < 9; i++)
                        rotMat.Set(i / 3, i % 3, RotationMatrix[i]);
                    fs.Write("RotationMatrix", rotMat);
                    rotMat.Dispose();
                }

                Console.WriteLine($"Saved depth + robot calibration to {DepthCalibFile}");
            }
            catch (Exception ex) { Console.WriteLine($"Save failed: {ex.Message}"); }
        }

        private void LoadDepthCalibration()
        {
            if (!System.IO.File.Exists(DepthCalibFile)) return;
            try
            {
                using var fs = new FileStorage(DepthCalibFile, FileStorage.Modes.Read);

                try
                {
                    DepthScale = fs["DepthScale"]?.ReadFloat() ?? 0;
                    DepthOffset = fs["DepthOffset"]?.ReadFloat() ?? 0;

                    if (DepthScale > 0)
                    {
                        IsDepthCalibrated = true;
                        Console.WriteLine($"Loaded depth calibration: Z = {DepthScale:F1} / (d + {DepthOffset:F2})");
                    }
                }
                catch { Console.WriteLine("  (depth params missing or invalid)"); }

                HasRobotTransform = false;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Load depth calib file error: {ex.Message}");
                Console.WriteLine("  Delete depth_calib.xml and redo calibration with E key");
            }
        }

        public double ApplyDepthCalibration(double disparity)
        {
            if (!IsDepthCalibrated || disparity <= 0) return 0;
            return DepthScale / (disparity + DepthOffset);
        }
    }

    public class ModbusCoordinateServer
    {
        private ModbusServer? _server;
        private Thread? _serverThread;
        private readonly object _lock = new();

        public void Start(int port)
        {
            _server = new ModbusServer { Port = port };
            _serverThread = new Thread(() => { try { _server.Listen(); } catch { } }) { IsBackground = true };
            _serverThread.Start();
            Console.WriteLine($"Modbus server on port {port}");
        }

        public bool IsTriggerSet()
        {
            if (_server == null) return false;
            lock (_lock)
            {
                return _server.holdingRegisters[9] == 1;
            }
        }

        public void ClearTrigger()
        {
            if (_server == null) return;
            lock (_lock)
            {
                _server.holdingRegisters[9] = 0;
            }
        }

        public void UpdateCoordinates(float x, float y, float z, int teaType = 0)
        {
            if (_server == null) return;

            lock (_lock)
            {
                _server.holdingRegisters[1] = (short)(x * 10);
                _server.holdingRegisters[3] = (short)(y * 10);
                _server.holdingRegisters[4] = (short)teaType;
                _server.holdingRegisters[5] = (short)(z * 10);
                _server.holdingRegisters[7] = (short)(x != 0 || y != 0 ? 1 : 0);
            }
        }

        public void Dispose() => _server?.StopListening();
    }


