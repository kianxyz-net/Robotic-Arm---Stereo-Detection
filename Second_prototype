    public class YoloDetector
    {
        private Net? _net;
        private string[] _labels = Array.Empty<string>();
        private const float ConfidenceThreshold = 0.15f;
        private const float NmsThreshold = 0.4f;

        public bool Initialize()
        {
            Console.WriteLine("Initializing YOLO...");
            try
            {
                string cfg = "yolov4-tiny.cfg";
                string weights = "yolov4-tiny.weights";
                string names = "coco.names";

                if (!System.IO.File.Exists(cfg) || !System.IO.File.Exists(weights))
                {
                    Console.WriteLine("YOLO model files not found!");
                    Console.WriteLine("Download:");
                    Console.WriteLine("  wget https://raw.githubusercontent.com/AlexeyAB/darknet/master/cfg/yolov4-tiny.cfg");
                    Console.WriteLine("  wget https://github.com/AlexeyAB/darknet/releases/download/darknet_yolo_v4_pre/yolov4-tiny.weights");
                    return false;
                }

                _net = CvDnn.ReadNetFromDarknet(cfg, weights);
                _net!.SetPreferableBackend(Backend.OPENCV);
                _net.SetPreferableTarget(Target.CPU);

                if (System.IO.File.Exists(names))
                    _labels = System.IO.File.ReadAllLines(names);
                else
                    _labels = new string[80];

                Console.WriteLine("YOLO ready");
                return true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"YOLO failed: {ex.Message}");
                return false;
            }
        }

        public List<DetectedObject> Detect(Mat frame)
        {
            var results = new List<DetectedObject>();
            if (_net == null) return results;

            using var blob = CvDnn.BlobFromImage(frame, 1 / 255.0, new Size(608, 608), new Scalar(), true, false);
            _net.SetInput(blob);

            var outNames = _net.GetUnconnectedOutLayersNames() ?? Array.Empty<string>();
            var outputs = outNames.Select(_ => new Mat()).ToArray();
            _net.Forward(outputs, outNames!);

            var boxes = new List<Rect>();
            var confidences = new List<float>();
            var classIds = new List<int>();

            foreach (var output in outputs)
            {
                for (int i = 0; i < output.Rows; i++)
                {
                    var scores = new float[_labels.Length];
                    for (int j = 0; j < _labels.Length; j++)
                        scores[j] = output.At<float>(i, 5 + j);

                    int classId = scores.ToList().IndexOf(scores.Max());
                    float confidence = scores[classId];

                    if (confidence > ConfidenceThreshold)
                    {
                        float centerX = output.At<float>(i, 0) * frame.Width;
                        float centerY = output.At<float>(i, 1) * frame.Height;
                        float width = output.At<float>(i, 2) * frame.Width;
                        float height = output.At<float>(i, 3) * frame.Height;

                        int x = (int)(centerX - width / 2);
                        int y = (int)(centerY - height / 2);

                        boxes.Add(new Rect(x, y, (int)width, (int)height));
                        confidences.Add(confidence);
                        classIds.Add(classId);
                    }
                }
                output.Dispose();
            }

            if (boxes.Count > 0)
            {
                CvDnn.NMSBoxes(boxes, confidences, ConfidenceThreshold, NmsThreshold, out int[] indices);

                foreach (int idx in indices)
                {
                    results.Add(new DetectedObject
                    {
                        Label = _labels[classIds[idx]],
                        Confidence = confidences[idx],
                        BoundingBox = boxes[idx]
                    });
                }
            }

            return results;
        }

        public void DrawDetections(Mat frame, List<DetectedObject> detections)
        {
            foreach (var det in detections)
            {
                Cv2.Rectangle(frame, det.BoundingBox, Scalar.LimeGreen, 2);

                string label;
                if (det.HasDepth)
                    label = $"{det.Label} ({det.X:F0},{det.Y:F0},{det.Z:F0}mm)";
                else
                    label = $"{det.Label} {det.Confidence:P0}";

                int baseLine;
                var labelSize = Cv2.GetTextSize(label, HersheyFonts.HersheySimplex, 0.5, 1, out baseLine);

                int top = Math.Max(det.BoundingBox.Y, labelSize.Height);
                Cv2.Rectangle(frame,
                    new Point(det.BoundingBox.X, top - labelSize.Height - 5),
                    new Point(det.BoundingBox.X + labelSize.Width, top),
                    Scalar.LimeGreen, Cv2.FILLED);
                Cv2.PutText(frame, label,
                    new Point(det.BoundingBox.X, top - 3),
                    HersheyFonts.HersheySimplex, 0.5, Scalar.Black, 1);
            }
        }
    }

    public class DetectedObject
    {
        public string Label { get; set; } = "";
        public float Confidence { get; set; }
        public Rect BoundingBox { get; set; }
        public float X { get; set; }
        public float Y { get; set; }
        public float Z { get; set; }
        public bool HasDepth { get; set; }

        public Point2f Center => new Point2f(
            BoundingBox.X + BoundingBox.Width / 2f,
            BoundingBox.Y + BoundingBox.Height / 2f);
    }

    // ===========================================================================
    // Hierarchical multi-color detector - MERGED FAMILIES
    // ---------------------------------------------------------------------------
    // Combines Red+Orange into one "Reddish" family, and White+Cardboard into
    // one "Light" family. Green stays standalone.
    //
    // RECTANGLE-FIT MASK CLEANUP:
    // Candy boxes (Skittles, Mike & Ike, etc.) have noisy packaging art that
    // produces swiss-cheese HSV masks. Instead of relying on morphological
    // close to bridge gaps, we:
    //   1. Do a light open to kill single-pixel noise
    //   2. Heavy dilate to merge nearby color fragments into clusters
    //   3. For each cluster, go back to the ORIGINAL mask pixels
    //   4. Fit a minAreaRect to those pixels (finds the candy box shape)
    //   5. Filter by aspect ratio (real boxes are ~1.3:1 to 4:1)
    //   6. Fill the fitted rectangle onto a clean mask
    // This turns fragmented color patches into solid filled rectangles that
    // match the actual box outline, giving clean centroids for pick-and-place.
    //
    // NOISE-PREVENTION APPROACH:
    // Each family is built by bitwise-OR-ing the ORIGINAL, already-tight HSV
    // masks -- NOT by widening a single continuous HSV range to span the gap
    // between them.
    //
    // Priority order (first match wins):
    //   1. GREEN     -> teaType 1
    //   2. REDDISH   -> teaType 2   (Red OR Orange, using ORIGINAL tight ranges)
    //   3. LIGHT     -> teaType 1   (White OR Cardboard, using ORIGINAL tight ranges)
    //
    // teaType mapping (binary):
    //   Green = 1
    //   Reddish (Red+Orange combined) = 2
    //   Light (White+Cardboard combined) = 1
    //
    // HSV ranges tuned for well-lit indoor/office lighting.
    // OpenCV HSV: H 0-179, S 0-255, V 0-255
    // ===========================================================================
    public class ColorDetector
    {
        // ---- GREEN (unchanged, standalone) ----
        private readonly Scalar _lowerGreen = new Scalar(35, 60, 40);
        private readonly Scalar _upperGreen = new Scalar(90, 255, 255);
        private const int MinAreaGreen = 800;

        // ---- RED (original tight range - one half of "Reddish") ----
        private readonly Scalar _lowerRed1 = new Scalar(0, 150, 60);
        private readonly Scalar _upperRed1 = new Scalar(8, 255, 255);
        private readonly Scalar _lowerRed2 = new Scalar(172, 150, 60);
        private readonly Scalar _upperRed2 = new Scalar(180, 255, 255);

        // ---- ORANGE (original tight range - other half of "Reddish") ----
        private readonly Scalar _lowerOrange = new Scalar(12, 150, 100);
        private readonly Scalar _upperOrange = new Scalar(22, 255, 255);

        // Combined "Reddish" family MinArea (lowered for candy boxes).
        private const int MinAreaReddish = 800;

        // ---- CARDBOARD (original tight range - one half of "Light") ----
        private readonly Scalar _lowerCardboard = new Scalar(8, 60, 80);
        private readonly Scalar _upperCardboard = new Scalar(22, 120, 190);

        // ---- WHITE (original tight range - other half of "Light") ----
        private readonly Scalar _lowerWhite = new Scalar(0, 0, 230);
        private readonly Scalar _upperWhite = new Scalar(179, 25, 255);

        // Combined "Light" family MinArea (lowered for candy boxes).
        private const int MinAreaLight = 1200;

        // Legacy field kept for backward compatibility - no longer used internally
        public int MinArea { get; set; } = 800;

        // ==== RECTANGLE-FIT TUNING CONSTANTS ====
        // Dilation kernel size for merging nearby color fragments into clusters.
        // Larger = more aggressive merging (bridges bigger gaps between fragments).
        // If candy box fragments are not merging into one cluster, increase this.
        private const int RectifyDilateSize = 31;

        // Number of dilation iterations. More iterations = larger merge radius.
        private const int RectifyDilateIterations = 2;

        // Minimum number of original-mask pixels in a cluster to consider it.
        // Filters out tiny noise clusters. Lower = more sensitive to small objects.
        private const int RectifyMinPixels = 100;

        // Aspect ratio bounds for fitted rectangles.
        // Candy boxes are roughly 1.3:1 to 4:1 (length:width).
        // Reject anything outside this range as noise (too square = blob, too thin = edge artifact).
        private const float RectifyMinAspect = 1.2f;
        private const float RectifyMaxAspect = 5.0f;

        // Minimum short-side length (pixels) of fitted rectangle.
        // Filters out tiny slivers that pass the aspect ratio check.
        private const float RectifyMinShortSide = 15f;

        /// <summary>
        /// Detect the highest-priority color family present in the frame.
        /// Priority: Green > Reddish (Red+Orange) > Light (White+Cardboard).
        /// Returns teaType: 0=none, 1=green/light category, 2=reddish category
        /// </summary>
        public (bool found, float cx, float cy, int teaType, Mat mask) DetectColor(Mat frame)
        {
            using var blurred = new Mat();
            Cv2.GaussianBlur(frame, blurred, new Size(15, 15), 0);

            using var hsv = new Mat();
            Cv2.CvtColor(blurred, hsv, ColorConversionCodes.BGR2HSV);

            // 1. GREEN -> teaType 1
            var result = TryDetect(hsv, _lowerGreen, _upperGreen, MinAreaGreen);
            if (result.found) return (true, result.cx, result.cy, 1, result.mask);
            result.mask.Dispose();

            // 2. REDDISH (Red OR Orange, via OR of tight masks) -> teaType 2
            var reddishResult = TryDetectMergedFamily(
                hsv,
                new[] { (_lowerRed1, _upperRed1), (_lowerRed2, _upperRed2), (_lowerOrange, _upperOrange) },
                MinAreaReddish);
            if (reddishResult.found) return (true, reddishResult.cx, reddishResult.cy, 2, reddishResult.mask);
            reddishResult.mask.Dispose();

            // 3. LIGHT (White OR Cardboard, via OR of tight masks) -> teaType 1
            var lightResult = TryDetectMergedFamily(
                hsv,
                new[] { (_lowerWhite, _upperWhite), (_lowerCardboard, _upperCardboard) },
                MinAreaLight);
            if (lightResult.found) return (true, lightResult.cx, lightResult.cy, 1, lightResult.mask);

            return (false, 0, 0, 0, lightResult.mask);
        }

        // Single-range detection with rectangle-fit mask cleanup
        private (bool found, float cx, float cy, Mat mask) TryDetect(Mat hsv, Scalar lower, Scalar upper, int minArea)
        {
            using var rawMask = new Mat();
            Cv2.InRange(hsv, lower, upper, rawMask);
            var mask = RectifyMask(rawMask);
            var (found, cx, cy, _) = FindLargestContour(mask, minArea);
            return (found, cx, cy, mask);
        }

        // Merged-family detection with rectangle-fit mask cleanup:
        // OR together N independently-tight HSV sub-ranges, then rectify.
        private (bool found, float cx, float cy, Mat mask) TryDetectMergedFamily(
            Mat hsv, (Scalar lower, Scalar upper)[] ranges, int minArea)
        {
            using var rawMask = new Mat(hsv.Size(), MatType.CV_8UC1, Scalar.All(0));

            foreach (var (lower, upper) in ranges)
            {
                using var subMask = new Mat();
                Cv2.InRange(hsv, lower, upper, subMask);
                Cv2.BitwiseOr(rawMask, subMask, rawMask);
            }

            var mask = RectifyMask(rawMask);
            var (found, cx, cy, _) = FindLargestContour(mask, minArea);
            return (found, cx, cy, mask);
        }

        /// <summary>
        /// Rectangle-fit mask cleanup.
        /// Takes a noisy HSV mask (swiss-cheese from packaging art) and produces
        /// a clean mask with solid filled rectangles where candy boxes are.
        ///
        /// Pipeline:
        ///   1. Light morphological open to remove single-pixel specks
        ///   2. Heavy dilation to merge nearby color fragments into clusters
        ///   3. Find contours on the dilated mask (each = one cluster)
        ///   4. For each cluster, go back to ORIGINAL denoised mask pixels
        ///   5. Fit minAreaRect to those original pixels
        ///   6. Filter by aspect ratio (reject non-rectangular noise)
        ///   7. Fill the fitted rotated rectangle onto a clean output mask
        /// </summary>
        private Mat RectifyMask(Mat rawMask)
        {
            // Step 1: Light open to kill single-pixel noise specks
            using var denoised = new Mat();
            using var openKernel = Cv2.GetStructuringElement(MorphShapes.Rect, new Size(5, 5));
            Cv2.MorphologyEx(rawMask, denoised, MorphTypes.Open, openKernel);

            // Step 2: Heavy dilation to merge nearby fragments into clusters.
            // This bridges gaps between scattered color patches on the same box.
            using var dilateKernel = Cv2.GetStructuringElement(MorphShapes.Ellipse,
                new Size(RectifyDilateSize, RectifyDilateSize));
            using var dilated = new Mat();
            Cv2.Dilate(denoised, dilated, dilateKernel, iterations: RectifyDilateIterations);

            // Step 3: Find cluster contours on the dilated mask
            Cv2.FindContours(dilated, out Point[][] clusters, out _,
                RetrievalModes.External, ContourApproximationModes.ApproxSimple);

            // Output: clean mask with filled rectangles
            var cleanMask = new Mat(rawMask.Size(), MatType.CV_8UC1, Scalar.All(0));

            foreach (var cluster in clusters)
            {
                if (Cv2.ContourArea(cluster) < RectifyMinPixels) continue;

                // Step 4: Go back to ORIGINAL denoised mask pixels within this cluster.
                // Create a filled mask for this cluster's dilated region.
                using var clusterRegion = new Mat(rawMask.Size(), MatType.CV_8UC1, Scalar.All(0));
                Cv2.DrawContours(clusterRegion, new[] { cluster }, 0, Scalar.White, Cv2.FILLED);

                // AND with denoised original to isolate real color pixels in this cluster
                using var realPixels = new Mat();
                Cv2.BitwiseAnd(denoised, clusterRegion, realPixels);

                // Collect non-zero points (the actual colored pixels)
                var nonZero = new Mat();
                Cv2.FindNonZero(realPixels, nonZero);
                if (nonZero.Empty() || nonZero.Rows < RectifyMinPixels)
                {
                    nonZero.Dispose();
                    continue;
                }

                // Convert to Point2f array for MinAreaRect
                int count = nonZero.Rows;
                var points = new Point2f[count];
                for (int i = 0; i < count; i++)
                {
                    var pt = nonZero.At<Point>(i, 0);
                    points[i] = new Point2f(pt.X, pt.Y);
                }
                nonZero.Dispose();

                // Step 5: Fit minimum-area rotated rectangle to the original pixels
                var rect = Cv2.MinAreaRect(points);

                // Step 6: Aspect ratio filter — reject non-rectangular shapes
                float longSide = Math.Max(rect.Size.Width, rect.Size.Height);
                float shortSide = Math.Min(rect.Size.Width, rect.Size.Height);

                if (shortSide < RectifyMinShortSide) continue;

                float aspect = longSide / shortSide;
                if (aspect > RectifyMaxAspect) continue;
                // Note: we intentionally do NOT filter on RectifyMinAspect here
                // because a square-ish cluster could be a box seen head-on.
                // The aspect filter only rejects implausibly thin slivers.

                // Step 7: Fill the fitted rotated rectangle onto clean mask
                var vertices = Cv2.BoxPoints(rect);
                var intVertices = vertices.Select(v => new Point((int)v.X, (int)v.Y)).ToArray();
                Cv2.FillConvexPoly(cleanMask, intVertices, Scalar.White);
            }

            return cleanMask;
        }

        // Legacy morphology method — kept for backward compatibility.
        // No longer called by the main detection pipeline (replaced by RectifyMask).
        private void ApplyMorphology(Mat mask)
        {
            using var openKernel = Cv2.GetStructuringElement(MorphShapes.Rect, new Size(5, 5));
            using var closeKernel = Cv2.GetStructuringElement(MorphShapes.Ellipse, new Size(35, 35));
            Cv2.MorphologyEx(mask, mask, MorphTypes.Open, openKernel);
            Cv2.MorphologyEx(mask, mask, MorphTypes.Close, closeKernel);
            Cv2.GaussianBlur(mask, mask, new Size(5, 5), 0);
            Cv2.Threshold(mask, mask, 127, 255, ThresholdTypes.Binary);
        }

        private (bool found, float cx, float cy, double area) FindLargestContour(Mat mask, int minArea)
        {
            Cv2.FindContours(mask, out Point[][] contours, out _, RetrievalModes.External, ContourApproximationModes.ApproxSimple);

            if (contours.Length == 0)
                return (false, 0, 0, 0);

            Point[]? largest = null;
            double maxArea = 0;
            foreach (var contour in contours)
            {
                double area = Cv2.ContourArea(contour);
                if (area > maxArea)
                {
                    maxArea = area;
                    largest = contour;
                }
            }

            if (largest == null || maxArea < minArea)
                return (false, 0, 0, 0);

            var hull = Cv2.ConvexHull(largest);
            var moments = Cv2.Moments(hull);

            if (moments.M00 == 0)
                return (false, 0, 0, 0);

            float cx = (float)(moments.M10 / moments.M00);
            float cy = (float)(moments.M01 / moments.M00);

            return (true, cx, cy, maxArea);
        }

        // Green-only detection (for hand-eye calibration - uses green pattern object)
        // Uses legacy ApplyMorphology since calibration uses a solid green object,
        // not noisy candy packaging.
        public (bool found, float cx, float cy, Mat mask) DetectGreen(Mat frame)
        {
            using var blurred = new Mat();
            Cv2.GaussianBlur(frame, blurred, new Size(15, 15), 0);

            using var hsv = new Mat();
            Cv2.CvtColor(blurred, hsv, ColorConversionCodes.BGR2HSV);

            var mask = new Mat();
            Cv2.InRange(hsv, _lowerGreen, _upperGreen, mask);
            ApplyMorphology(mask);
            var (found, cx, cy, _) = FindLargestContour(mask, MinAreaGreen);
            return (found, cx, cy, mask);
        }
    }

    public class StereoDepth
    {
        private const string CalibFile = "stereo_calib.xml";
        private const string DepthCalibFile = "depth_calib.xml";

        private readonly int cornersX = 9;
        private readonly int cornersY = 6;
        private readonly float squareSize = 20f;

        private Mat? K1, K2;
        private Mat? D1, D2;
        private Mat? R, T;
        private Mat? R1, R2, P1, P2;
        private Mat? Q;
        private Mat? map1x, map1y;
        private Mat? map2x, map2y;

        private List<(Point2f[] corners1, Point2f[] corners2)> captures = new();
        private Size imageSize;

        public bool IsCalibrated { get; private set; }
        public bool IsCapturing { get; private set; }
        public int CaptureCount => captures.Count;

        private double DepthScale = 0;
        private double DepthOffset = 0;
        public bool IsDepthCalibrated { get; private set; }
        public bool IsDepthCalibrating { get; private set; }
        public bool QuietMode { get; set; } = false;
        private List<(double disparity, double actualDistance)> depthSamples = new();

        private List<(double cx, double cy, double cz, double rx, double ry, double rz)> pointCorrespondences = new();
        public double[] RotationMatrix { get; private set; } = new double[9] { 1, 0, 0, 0, 1, 0, 0, 0, 1 };
        public double TranslationX { get; private set; } = 0;
        public double TranslationY { get; private set; } = 0;
        public double TranslationZ { get; private set; } = 0;
        public bool HasRobotTransform { get; private set; } = false;

        public Mat? GetK1() => K1;
        public Mat? GetD1() => D1;

        public double GetFocalLength()
        {
            if (Q == null) return 600;
            return Q.At<double>(2, 3);
        }

        private StereoSGBM? stereoMatcher;

        public StereoDepth()
        {
            Console.WriteLine($"Chessboard: {cornersX}x{cornersY} inner corners, {squareSize}mm squares");
            Load();
            LoadDepthCalibration();
        }

        public void StartCalibration()
        {
            Console.WriteLine("\n=== STEREO CALIBRATION (Chessboard) ===");
            Console.WriteLine($"Board: {cornersX}x{cornersY} inner corners = {cornersX+1}x{cornersY+1} squares");
            Console.WriteLine($"Square size: {squareSize}mm");
            Console.WriteLine("Press SPACE to capture. Need 15-20 from different angles.");
            Console.WriteLine("Press C to compute calibration.\n");

            captures.Clear();
            IsCapturing = true;
        }

        public bool CaptureCalibrationFrame(Mat frame1, Mat frame2)
        {
            if (!IsCapturing) return false;

            imageSize = frame1.Size();
            var boardSize = new Size(cornersX, cornersY);

            using var gray1 = new Mat();
            using var gray2 = new Mat();
            Cv2.CvtColor(frame1, gray1, ColorConversionCodes.BGR2GRAY);
            Cv2.CvtColor(frame2, gray2, ColorConversionCodes.BGR2GRAY);

            bool found1 = Cv2.FindChessboardCorners(gray1, boardSize, out Point2f[] corners1,
                ChessboardFlags.AdaptiveThresh | ChessboardFlags.NormalizeImage);
            bool found2 = Cv2.FindChessboardCorners(gray2, boardSize, out Point2f[] corners2,
                ChessboardFlags.AdaptiveThresh | ChessboardFlags.NormalizeImage);

            if (!found1 || !found2)
            {
                Console.WriteLine($"Chessboard not found (cam1:{found1}, cam2:{found2})");
                return false;
            }

            Cv2.CornerSubPix(gray1, corners1, new Size(11, 11), new Size(-1, -1),
                new TermCriteria(CriteriaTypes.Eps | CriteriaTypes.MaxIter, 30, 0.001));
            Cv2.CornerSubPix(gray2, corners2, new Size(11, 11), new Size(-1, -1),
                new TermCriteria(CriteriaTypes.Eps | CriteriaTypes.MaxIter, 30, 0.001));

            captures.Add((corners1, corners2));

            Cv2.DrawChessboardCorners(frame1, boardSize, corners1, found1);
            Cv2.DrawChessboardCorners(frame2, boardSize, corners2, found2);

            Console.WriteLine($"Captured {captures.Count}");
            return true;
        }

        public bool ComputeCalibration()
        {
            if (captures.Count < 10)
            {
                Console.WriteLine($"Need 10+ captures, have {captures.Count}");
                return false;
            }

            Console.WriteLine($"\nCalibrating from {captures.Count} captures...");

            try
            {
                int numCorners = cornersX * cornersY;

                var objPts = new Point3f[numCorners];
                for (int y = 0; y < cornersY; y++)
                {
                    for (int x = 0; x < cornersX; x++)
                    {
                        objPts[y * cornersX + x] = new Point3f(x * squareSize, y * squareSize, 0);
                    }
                }

                var objPtsList = new List<IEnumerable<Point3f>>();
                var img1PtsList = new List<IEnumerable<Point2f>>();
                var img2PtsList = new List<IEnumerable<Point2f>>();

                var allObjPts = new Mat[captures.Count];
                var allImg1Pts = new Mat[captures.Count];
                var allImg2Pts = new Mat[captures.Count];

                for (int i = 0; i < captures.Count; i++)
                {
                    var (corners1, corners2) = captures[i];

                    objPtsList.Add(objPts);
                    img1PtsList.Add(corners1);
                    img2PtsList.Add(corners2);

                    var objMat = new Mat(objPts.Length, 1, MatType.CV_32FC3);
                    for (int j = 0; j < objPts.Length; j++)
                    {
                        objMat.Set(j, 0, new Vec3f(objPts[j].X, objPts[j].Y, objPts[j].Z));
                    }
                    allObjPts[i] = objMat;

                    var img1Mat = new Mat(corners1.Length, 1, MatType.CV_32FC2);
                    for (int j = 0; j < corners1.Length; j++)
                    {
                        img1Mat.Set(j, 0, new Vec2f(corners1[j].X, corners1[j].Y));
                    }
                    allImg1Pts[i] = img1Mat;

                    var img2Mat = new Mat(corners2.Length, 1, MatType.CV_32FC2);
                    for (int j = 0; j < corners2.Length; j++)
                    {
                        img2Mat.Set(j, 0, new Vec2f(corners2[j].X, corners2[j].Y));
                    }
                    allImg2Pts[i] = img2Mat;
                }

                K1 = Mat.Eye(3, 3, MatType.CV_64FC1);
                K2 = Mat.Eye(3, 3, MatType.CV_64FC1);
                D1 = new Mat(1, 5, MatType.CV_64FC1, Scalar.All(0));
                D2 = new Mat(1, 5, MatType.CV_64FC1, Scalar.All(0));

                Console.WriteLine("Calibrating camera 1...");
                Mat[] rvecs1, tvecs1;
                double rms1 = Cv2.CalibrateCamera(allObjPts, allImg1Pts, imageSize, K1, D1, out rvecs1, out tvecs1);
                Console.WriteLine($"Camera 1 RMS: {rms1:F4}");

                Console.WriteLine("Calibrating camera 2...");
                Mat[] rvecs2, tvecs2;
                double rms2 = Cv2.CalibrateCamera(allObjPts, allImg2Pts, imageSize, K2, D2, out rvecs2, out tvecs2);
                Console.WriteLine($"Camera 2 RMS: {rms2:F4}");

                Console.WriteLine("Computing stereo parameters with StereoCalibrate...");

                R = new Mat();
                T = new Mat();
                Mat E = new Mat();
                Mat F = new Mat();

                var K1_arr = new double[3, 3];
                var K2_arr = new double[3, 3];
                for (int row = 0; row < 3; row++)
                {
                    for (int col = 0; col < 3; col++)
                    {
                        K1_arr[row, col] = K1.At<double>(row, col);
                        K2_arr[row, col] = K2.At<double>(row, col);
                    }
                }
                var D1_arr = new double[5];
                var D2_arr = new double[5];
                for (int j = 0; j < 5; j++)
                {
                    D1_arr[j] = D1.At<double>(0, j);
                    D2_arr[j] = D2.At<double>(0, j);
                }

                double stereoRms = Cv2.StereoCalibrate(
                    objPtsList,
                    img1PtsList,
                    img2PtsList,
                    K1_arr, D1_arr, K2_arr, D2_arr,
                    imageSize,
                    R, T, E, F,
                    CalibrationFlags.FixIntrinsic,
                    new TermCriteria(CriteriaTypes.Eps | CriteriaTypes.MaxIter, 100, 1e-5)
                );

                for (int row = 0; row < 3; row++)
                {
                    for (int col = 0; col < 3; col++)
                    {
                        K1.Set(row, col, K1_arr[row, col]);
                        K2.Set(row, col, K2_arr[row, col]);
                    }
                }
                for (int j = 0; j < 5; j++)
                {
                    D1.Set(0, j, D1_arr[j]);
                    D2.Set(0, j, D2_arr[j]);
                }

                Console.WriteLine($"Stereo RMS: {stereoRms:F4}");

                float baseline = (float)Cv2.Norm(T);
                Console.WriteLine($"Estimated baseline: {baseline:F1}mm");

                E.Dispose();
                F.Dispose();

                foreach (var m in allObjPts) m.Dispose();
                foreach (var m in allImg1Pts) m.Dispose();
                foreach (var m in allImg2Pts) m.Dispose();
                foreach (var m in rvecs1) m.Dispose();
                foreach (var m in tvecs1) m.Dispose();
                foreach (var m in rvecs2) m.Dispose();
                foreach (var m in tvecs2) m.Dispose();

                R1 = new Mat(); R2 = new Mat();
                P1 = new Mat(); P2 = new Mat();
                Q = new Mat();

                Cv2.StereoRectify(K1, D1, K2, D2, imageSize, R, T,
                    R1, R2, P1, P2, Q,
                    StereoRectificationFlags.ZeroDisparity, -1, imageSize);

                double f = Q.At<double>(2, 3);
                double Tx = 1.0 / Q.At<double>(3, 2);
                Console.WriteLine($"Q matrix: focal={f:F1}px, Tx={Tx:F1}mm");
                Console.WriteLine($"Expected disparity at 1000mm: {f * baseline / 1000:F1}px");
                Console.WriteLine($"Expected disparity at 1500mm: {f * baseline / 1500:F1}px");
                Console.WriteLine($"Expected disparity at 2000mm: {f * baseline / 2000:F1}px");

                double minDepth = f * baseline / 256;
                Console.WriteLine($"Stereo matching: min depth ~{minDepth:F0}mm (objects closer than this won't be detected)");

                map1x = new Mat(); map1y = new Mat();
                map2x = new Mat(); map2y = new Mat();
                Cv2.InitUndistortRectifyMap(K1, D1, R1, P1, imageSize, MatType.CV_32FC1, map1x, map1y);
                Cv2.InitUndistortRectifyMap(K2, D2, R2, P2, imageSize, MatType.CV_32FC1, map2x, map2y);

                InitStereoMatcher();

                IsCalibrated = true;
                IsCapturing = false;
                Save();

                Console.WriteLine($"Done! Baseline: {baseline:F1}mm");
                Console.WriteLine("\nStereo calibration complete!\n");
                return true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed: {ex.Message}\n{ex.StackTrace}");
                return false;
            }
        }

        private void InitStereoMatcher()
        {
            stereoMatcher = StereoSGBM.Create(
                0, 256, 5,
                8 * 3 * 5 * 5,
                32 * 3 * 5 * 5,
                1, 63, 5, 100, 2,
                StereoSGBMMode.HH
            );
        }

        public Mat ComputeDisparity(Mat frame1, Mat frame2)
        {
            if (!IsCalibrated || stereoMatcher == null ||
                map1x == null || map1y == null || map2x == null || map2y == null)
                return new Mat();

            using var r1 = new Mat();
            using var r2 = new Mat();
            Cv2.Remap(frame1, r1, map1x, map1y, InterpolationFlags.Linear);
            Cv2.Remap(frame2, r2, map2x, map2y, InterpolationFlags.Linear);

            using var g1 = new Mat();
            using var g2 = new Mat();
            Cv2.CvtColor(r1, g1, ColorConversionCodes.BGR2GRAY);
            Cv2.CvtColor(r2, g2, ColorConversionCodes.BGR2GRAY);

            var disparity = new Mat();
            stereoMatcher.Compute(g1, g2, disparity);

            using var temp = disparity.Clone();
            Cv2.MedianBlur(temp, disparity, 5);

            return disparity;
        }

