        }

        public bool ComputeCalibration()
        {
            if (points.Count < 3)
            {
                Console.WriteLine($"Need at least 3 points, have {points.Count}");
                return false;
            }

            Console.WriteLine($"\nComputing transform from {points.Count} points...");

            int n = points.Count;

            double camCentX = points.Average(p => p.cx);
            double camCentY = points.Average(p => p.cy);
            double camCentZ = points.Average(p => p.cz);
            double robCentX = points.Average(p => p.rx);
            double robCentY = points.Average(p => p.ry);
            double robCentZ = points.Average(p => p.rz);

            double camVar = 0;
            foreach (var p in points)
            {
                camVar += Math.Pow(p.cx - camCentX, 2) + Math.Pow(p.cy - camCentY, 2) + Math.Pow(p.cz - camCentZ, 2);
            }
            camVar /= n;

            double[,] H = new double[3, 3];
            foreach (var p in points)
            {
                double cx = p.cx - camCentX;
                double cy = p.cy - camCentY;
                double cz = p.cz - camCentZ;
                double rx = p.rx - robCentX;
                double ry = p.ry - robCentY;
                double rz = p.rz - robCentZ;

                H[0, 0] += rx * cx; H[0, 1] += rx * cy; H[0, 2] += rx * cz;
                H[1, 0] += ry * cx; H[1, 1] += ry * cy; H[1, 2] += ry * cz;
                H[2, 0] += rz * cx; H[2, 1] += rz * cy; H[2, 2] += rz * cz;
            }

            using var HMat = new Mat(3, 3, MatType.CV_64FC1);
            for (int i = 0; i < 3; i++)
                for (int j = 0; j < 3; j++)
                    HMat.Set(i, j, H[i, j]);

            using var W = new Mat();
            using var U = new Mat();
            using var Vt = new Mat();
            Cv2.SVDecomp(HMat, W, U, Vt);

            using var R_mat = new Mat();
            using var emptyMat = new Mat();
            Cv2.Gemm(U, Vt, 1, emptyMat, 0, R_mat);

            double det = Cv2.Determinant(R_mat);
            if (det < 0)
            {
                for (int i = 0; i < 3; i++)
                    U.Set(i, 2, -U.At<double>(i, 2));
                Cv2.Gemm(U, Vt, 1, emptyMat, 0, R_mat);
            }

            for (int i = 0; i < 3; i++)
                for (int j = 0; j < 3; j++)
                    RotationMatrix[i * 3 + j] = R_mat.At<double>(i, j);

            double traceRH = 0;
            for (int i = 0; i < 3; i++)
            {
                double sign = (i == 2 && det < 0) ? -1 : 1;
                traceRH += sign * W.At<double>(i, 0);
            }
            Scale = traceRH / (n * camVar);

            double rcx = Scale * (RotationMatrix[0] * camCentX + RotationMatrix[1] * camCentY + RotationMatrix[2] * camCentZ);
            double rcy = Scale * (RotationMatrix[3] * camCentX + RotationMatrix[4] * camCentY + RotationMatrix[5] * camCentZ);
            double rcz = Scale * (RotationMatrix[6] * camCentX + RotationMatrix[7] * camCentY + RotationMatrix[8] * camCentZ);

            TranslationX = robCentX - rcx;
            TranslationY = robCentY - rcy;
            TranslationZ = robCentZ - rcz;

            Console.WriteLine("\n===== HAND-EYE CALIBRATION COMPLETE =====");
            Console.WriteLine($"Scale: {Scale:F4}");
            Console.WriteLine($"Translation: ({TranslationX:F1}, {TranslationY:F1}, {TranslationZ:F1}) mm");
            Console.WriteLine("Rotation matrix:");
            Console.WriteLine($"  [{RotationMatrix[0]:F4} {RotationMatrix[1]:F4} {RotationMatrix[2]:F4}]");
            Console.WriteLine($"  [{RotationMatrix[3]:F4} {RotationMatrix[4]:F4} {RotationMatrix[5]:F4}]");
            Console.WriteLine($"  [{RotationMatrix[6]:F4} {RotationMatrix[7]:F4} {RotationMatrix[8]:F4}]");

            Console.WriteLine("\nCalibration errors:");
            double totalError = 0;
            for (int i = 0; i < points.Count; i++)
            {
                var p = points[i];
                var (predX, predY, predZ) = TransformToRobot((float)p.cx, (float)p.cy, (float)p.cz);
                double error = Math.Sqrt(Math.Pow(predX - p.rx, 2) + Math.Pow(predY - p.ry, 2) + Math.Pow(predZ - p.rz, 2));
                totalError += error;
                Console.WriteLine($"  Point {i + 1}: error = {error:F1} mm");
            }
            Console.WriteLine($"Average error: {totalError / n:F1} mm");

            IsCalibrating = false;
            IsCalibrated = true;
            pendingCameraPoint = null;
            Save();

            Console.WriteLine("\nCalibration saved to robot_calib.xml\n");
            return true;
        }

        public (float rx, float ry, float rz) TransformToRobot(float cx, float cy, float cz)
        {
            if (!IsCalibrated) return (cx, cy, cz);

            double rx = Scale * (RotationMatrix[0] * cx + RotationMatrix[1] * cy + RotationMatrix[2] * cz) + TranslationX;
            double ry = Scale * (RotationMatrix[3] * cx + RotationMatrix[4] * cy + RotationMatrix[5] * cz) + TranslationY;
            double rz = Scale * (RotationMatrix[6] * cx + RotationMatrix[7] * cy + RotationMatrix[8] * cz) + TranslationZ;

            return ((float)rx, (float)ry, (float)rz);
        }

        private void Save()
        {
            try
            {
                using var fs = new FileStorage(CalibFile, FileStorage.Modes.Write);
                fs.Write("Scale", Scale);
                fs.Write("TranslationX", TranslationX);
                fs.Write("TranslationY", TranslationY);
                fs.Write("TranslationZ", TranslationZ);

                var rotMat = new Mat(3, 3, MatType.CV_64F);
                for (int i = 0; i < 9; i++)
                    rotMat.Set(i / 3, i % 3, RotationMatrix[i]);
                fs.Write("RotationMatrix", rotMat);
                rotMat.Dispose();
            }
            catch (Exception ex) { Console.WriteLine($"Save failed: {ex.Message}"); }
        }

        private void Load()
        {
            if (!System.IO.File.Exists(CalibFile)) return;
            try
            {
                using var fs = new FileStorage(CalibFile, FileStorage.Modes.Read);

                Scale = fs["Scale"]?.ReadFloat() ?? 1.0;
                TranslationX = fs["TranslationX"]?.ReadFloat() ?? 0;
                TranslationY = fs["TranslationY"]?.ReadFloat() ?? 0;
                TranslationZ = fs["TranslationZ"]?.ReadFloat() ?? 0;

                using var rotMat = fs["RotationMatrix"]?.ReadMat();
                if (rotMat != null && !rotMat.Empty())
                {
                    for (int i = 0; i < 9; i++)
                        RotationMatrix[i] = rotMat.At<double>(i / 3, i % 3);
                }

                IsCalibrated = true;
                Console.WriteLine($"Loaded hand-eye calibration (Scale: {Scale:F3}, T: {TranslationX:F0}, {TranslationY:F0}, {TranslationZ:F0})");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to load robot calibration: {ex.Message}");
            }
        }
    }

    class Program
    {
        static bool running = true;
        static Dictionary<string, (float x, float y, float z, int age)> lastDepth = new();
        static Dictionary<string, List<(float x, float y, float z)>> depthBuffer = new();
        const int MaxAge = 10;
        const int BufferSize = 7;
        static DateTime lastRobotPrint = DateTime.MinValue;
        static DateTime _lastTriangDebug = DateTime.MinValue;

        // === EDGE MASKING ===
        // Percentage of frame to black out from EACH side (left, right, top, AND bottom).
        // 0.0 = no masking. 0.20 = block out 20% from every edge (a smaller centered
        // region remains visible - roughly 60% width x 60% height in the middle).
        // Adjust this value to tune how much of the edges gets ignored by color detection.
        static double EdgeMaskPercent = 0.1;

        // Blacks out the left, right, top, and bottom edges of the frame in-place.
        // Percent is per-side: 0.20 means 20% blocked on EACH of the 4 sides (not 20% total).
        static void ApplyEdgeMask(Mat frame, double percentPerSide)
        {
            if (percentPerSide <= 0) return;
            percentPerSide = Math.Clamp(percentPerSide, 0.0, 0.49); // cap under 50% per side so some center always remains

            int width = frame.Width;
            int height = frame.Height;
            int blockWidth = (int)(width * percentPerSide);
            int blockHeight = (int)(height * percentPerSide);

            if (blockWidth <= 0 && blockHeight <= 0) return;

            // Left strip
            if (blockWidth > 0)
                Cv2.Rectangle(frame, new Rect(0, 0, blockWidth, height), Scalar.Black, -1);
            // Right strip
            if (blockWidth > 0)
                Cv2.Rectangle(frame, new Rect(width - blockWidth, 0, blockWidth, height), Scalar.Black, -1);
            // Top strip
            if (blockHeight > 0)
                Cv2.Rectangle(frame, new Rect(0, 0, width, blockHeight), Scalar.Black, -1);
            // Bottom strip
            if (blockHeight > 0)
                Cv2.Rectangle(frame, new Rect(0, height - blockHeight, width, blockHeight), Scalar.Black, -1);
        }

        static Rect ExpandRect(Rect r, int margin, int maxWidth, int maxHeight)
        {
            int x = Math.Max(0, r.X - margin);
            int y = Math.Max(0, r.Y - margin);
            int w = Math.Min(r.Width + 2 * margin, maxWidth - x);
            int h = Math.Min(r.Height + 2 * margin, maxHeight - y);
            return new Rect(x, y, w, h);
        }

